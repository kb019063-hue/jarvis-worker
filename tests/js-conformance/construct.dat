1 2 true true object

#name a singleton parent: every new gives the one object, and the child's constructor runs on it again
#code
var instance = null, runs = 0;
class Registry { constructor() { if (instance) return instance; instance = this; this.items = []; } }
class AppRegistry extends Registry { constructor(name) { super(); runs++; this.items.push(name); } }
var a = new AppRegistry('a'), b = new AppRegistry('b'), c = new Registry();
console.log(a === b, b === c, a.items.join(), runs, a instanceof AppRegistry);
#expect
true true a,b 2 true

#name what Babel emits for a class hierarchy: _createSuper with Reflect.construct
#code
function _getPrototypeOf(o) { return Object.getPrototypeOf(o); }
function _inherits(subClass, superClass) {
  subClass.prototype = Object.create(superClass && superClass.prototype, { constructor: { value: subClass, writable: true, configurable: true } });
  Object.defineProperty(subClass, 'prototype', { writable: false });
  if (superClass) Object.setPrototypeOf(subClass, superClass);
}
function _possibleConstructorReturn(self, call) {
  if (call && (typeof call === 'object' || typeof call === 'function')) return call;
  if (call !== void 0) throw new TypeError('Derived constructors may only return object or undefined');
  if (self === void 0) throw new ReferenceError("this hasn't been initialised - super() hasn't been called");
  return self;
}
function _createSuper(Derived) {
  return function _createSuperInternal() {
    var Super = _getPrototypeOf(Derived), NewTarget = _getPrototypeOf(this).constructor;
    return _possibleConstructorReturn(this, Reflect.construct(Super, arguments, NewTarget));
  };
}
var Animal = function Animal(name) { this.name = name; this.madeAs = new.target.name; };
Animal.prototype.speak = function () { return this.name + ' makes a sound'; };
var Dog = (function (_Animal) {
  _inherits(Dog, _Animal);
  var _super = _createSuper(Dog);
  function Dog(name) { var _this; _this = _super.call(this, name); _this.tricks = []; return _this; }
  Dog.prototype.speak = function () { return this.name + ' barks'; };
  return Dog;
})(Animal);
var Puppy = (function (_Dog) {
  _inherits(Puppy, _Dog);
  var _super2 = _createSuper(Puppy);
  function Puppy() { var _this2; _this2 = _super2.apply(this, arguments); _this2.age = 0; return _this2; }
  return Puppy;
})(Dog);
var p = new Puppy('Rex'), d = new Dog('Fido');
console.log(p.name, p.madeAs, p.age, p.tricks.length, p.speak(), p instanceof Puppy, p instanceof Dog, p instanceof Animal);
console.log(d.madeAs, d.speak(), d instanceof Puppy, Object.getPrototypeOf(p) === Puppy.prototype, p.constructor === Puppy);
#expect
Rex Puppy 0 0 Rex barks true true true
Dog Fido barks false true true

#name what Babel emits for a subclass of a built-in: _wrapNativeSuper
#code
function _construct(Parent, args, Class) { return Reflect.construct(Parent, args, Class); }
function _wrapNativeSuper(Class) {
  function Wrapper() { return _construct(Class, arguments, Object.getPrototypeOf(this).constructor); }
  Wrapper.prototype = Object.create(Class.prototype, { constructor: { value: Wrapper, enumerable: false, writable: true, configurable: true } });
  return Object.setPrototypeOf(Wrapper, Class);
}
function _inherits(subClass, superClass) {
  subClass.prototype = Object.create(superClass.prototype, { constructor: { value: subClass, writable: true, configurable: true } });
  Object.setPrototypeOf(subClass, superClass);
}
var HttpError = (function (_Error) {
  _inherits(HttpError, _Error);
  function HttpError(status, message) {
    var _this = Reflect.construct(_Error, [message], Object.getPrototypeOf(this).constructor);
    _this.status = status; _this.name = 'HttpError';
    return _this;
  }
  return HttpError;
})(_wrapNativeSuper(Error));
var List = (function (_Array) {
  _inherits(List, _Array);
  function List() { return Reflect.construct(_Array, arguments, Object.getPrototypeOf(this).constructor); }
  List.prototype.last = function () { return this[this.length - 1]; };
  return List;
})(_wrapNativeSuper(Array));
var e = new HttpError(404, 'not found'), l = new List(1, 2, 3);
l.push(4);
console.log(e instanceof HttpError, e instanceof Error, e.status, e.message, String(e), Object.prototype.toString.call(e));
console.log(l instanceof List, Array.isArray(l), l.length, l.last(), l.join('+'));
#expect
true true 404 not found HttpError: not found [object Error]
true true 4 4 1+2+3+4

