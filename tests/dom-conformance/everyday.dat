#name elements/parents
#code
function parents(el, selector) {
  const parents = [];
  while ((el = el.parentNode) && el !== document) {
    if (!selector || el.matches(selector)) parents.push(el);
  }
  return parents;
}
var el = document.querySelector('b');
console.log(parents(el).map((p) => p.tagName).join(' '), parents(el, 'div').length, parents(el, '.text')[0].tagName);
#expect
P DIV BODY HTML 1 P

