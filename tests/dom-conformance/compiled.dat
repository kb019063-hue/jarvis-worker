true true true button button pressed false undefined
true true button submit
true undefined true button

#name a constructor asks for its element once: a second request in an upgrade is refused, under new it makes another
#html
<html><head><title>Upgrade</title></head><body><x-twice id="twice"></x-twice><div id="host"></div></body></html>
#code
var seen = [];
function Twice() {
  var self = Reflect.construct(HTMLElement, [], new.target), other;
  try { other = Reflect.construct(HTMLElement, [], new.target); seen.push('second: ' + (other !== self) + ' ' + other.localName + ' ' + (other.id || 'no id')); }
  catch (e) { seen.push('second: ' + e.name); }
  return self;
}
Twice.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Twice, writable: true, configurable: true } });
Object.setPrototypeOf(Twice, HTMLElement);
customElements.define('x-twice', Twice);
var e = document.getElementById('twice');
console.log(e instanceof Twice, seen.join(' | '));
seen.length = 0;
var n = new Twice();
console.log(n instanceof Twice, n !== e, seen.join(' | '));
seen.length = 0;
document.getElementById('host').innerHTML = '<x-twice></x-twice>';
var c = document.createElement('x-twice');
console.log(seen.join(' | '), c instanceof Twice);
#expect
true second: TypeError
true true second: true x-twice no id
second: TypeError | second: true x-twice no id true

#name an instance made inside an upgrade, before the constructor asked, is the element being upgraded
#html
<html><head><title>Upgrade</title></head><body><x-nested id="outer"></x-nested><div id="host"></div></body></html>
#code
var seen = [], depth = 0;
function Nested() {
  var inner = null, self;
  if (depth++ === 0) inner = new Nested();
  try { self = Reflect.construct(HTMLElement, [], new.target); }
  catch (e) { seen.push('own: ' + e.name); return inner; }
  seen.push('made ' + (self.id || 'no id'));
  return self;
}
Nested.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Nested, writable: true, configurable: true } });
Object.setPrototypeOf(Nested, HTMLElement);
customElements.define('x-nested', Nested);
var e = document.getElementById('outer');
console.log(seen.join(' | '), e instanceof Nested, e.matches(':defined'));
seen.length = 0; depth = 0;
var fresh = new Nested();
console.log(seen.join(' | '), fresh instanceof Nested, fresh !== e, fresh.localName);
#expect
made outer | own: TypeError true true
made no id | made no id true true x-nested

