#fixture
<html><head><title>Forms</title></head><body>
<form id="f" action="/submit" method="post">
<input type="text" name="user" id="user" value="ann" maxlength="10">
<input type="password" name="pw" id="pw">
<input type="checkbox" name="news" id="news" value="yes" checked>
<input type="checkbox" name="terms" id="terms">
<input type="radio" name="size" id="small" value="s">
<input type="radio" name="size" id="large" value="l" checked>
<input type="hidden" name="token" value="t0k">
<input type="number" name="age" id="age" min="1" max="120" value="30">
<input type="email" name="mail" id="mail" required>
<select name="color" id="color"><option value="r">Red</option><option value="g" selected>Green</option><option>Blue</option></select>
<select name="tags" id="tags" multiple><option value="a" selected>A</option><option value="b">B</option><option value="c" selected>C</option></select>
<textarea name="note" id="note">first
second</textarea>
<input type="text" name="off" id="off" value="x" disabled>
<input type="file" name="up" id="up">
<button type="submit" id="go" name="action" value="save">Save</button>
<button type="button" id="plain">Plain</button>
<input type="reset" id="reset">
</form>
<label id="lab" for="user">User</label>
<label id="wrap">Terms <input type="checkbox" id="inside"></label>
<input type="text" id="outside" form="f" name="far" value="away">
</body></html>

#name value of a text input: the attribute is the default, the property is the state
#code
var u = document.getElementById('user');
console.log(u.value, u.defaultValue, u.getAttribute('value'));
u.value = 'bob';
console.log(u.value, u.defaultValue, u.getAttribute('value'));
u.setAttribute('value', 'cat');
console.log(u.value, u.defaultValue);
u.defaultValue = 'dog';
console.log(u.value, u.getAttribute('value'));
u.value = null; console.log(JSON.stringify(u.value)); u.value = 5; console.log(u.value, typeof u.value);
#expect
ann ann ann
bob ann ann
bob cat
bob dog
""
5 string

#name before a script sets value, the attribute shows through
#code
var u = document.getElementById('user');
u.setAttribute('value', 'changed');
console.log(u.value);
u.removeAttribute('value');
console.log(JSON.stringify(u.value));
#expect
changed
""

#name checked: the attribute is the default, the property is the state
#code
var n = document.getElementById('news'), t = document.getElementById('terms');
console.log(n.checked, n.defaultChecked, t.checked, t.defaultChecked);
n.checked = false; t.checked = true;
console.log(n.checked, n.hasAttribute('checked'), n.defaultChecked, t.checked, t.hasAttribute('checked'));
n.removeAttribute('checked'); t.setAttribute('checked', '');
console.log(n.checked, t.checked);
t.defaultChecked = false;
console.log(t.hasAttribute('checked'), t.checked);
#expect
true true false false
false true true true false
false true
false true

#name the value of a checkbox defaults to "on"
#code
var t = document.getElementById('terms');
console.log(t.value, document.getElementById('news').value, t.hasAttribute('value'));
t.value = 'agree';
console.log(t.getAttribute('value'), t.value);
#expect
on yes false
agree agree

#name radio buttons with one name: checking one unchecks the others
#code
var s = document.getElementById('small'), l = document.getElementById('large');
console.log(s.checked, l.checked);
s.checked = true;
console.log(s.checked, l.checked, l.hasAttribute('checked'));
s.checked = false;
console.log(s.checked, l.checked);
var loose = document.createElement('input'); loose.type = 'radio'; loose.name = 'size'; loose.checked = true;
console.log(loose.checked, s.checked);
document.getElementById('f').appendChild(loose);
l.checked = true;
console.log(loose.checked, l.checked);
#expect
false true
true false true
false false
true false
false true

#name the form's elements and named access
#code
var f = document.getElementById('f');
console.log(f.elements.length, f.length, f.elements.user === document.getElementById('user'), f.elements['size'].length, f.elements.size.value, f.elements.far.id, f.elements.token.value);
console.log(f.elements.size instanceof RadioNodeList, f.elements.size[0].id, f.elements.namedItem('age').value, f.elements[0].name);
f.elements.size.value = 's';
console.log(document.getElementById('small').checked, f.elements.size.value);
#expect
18 18 true 2 l outside t0k
true small 30 user
true s

#name each control knows its form
