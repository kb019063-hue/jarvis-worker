#name a caught exception keeps its message alive
#code
var kept;
try {
  throw new Error("boom");
} catch (e) {
  kept = e;
}
console.log(kept.message, kept instanceof Error);
var again = 0;
for (var i = 0; i < 100; i++) {
  try { throw new Error("tick" + i); } catch (e) { again += e.message.length > 0 ? 1 : 0; }
}
console.log(again);
#expect
boom true
100

#name a finally block runs with its bindings alive
#code
function f() {
  var log = [];
  try {
    log.push("try");
    throw new Error("x");
  } catch (e) {
    log.push("catch:" + e.message);
    return log.join(",");
  } finally {
    log.push("finally");
  }
}
console.log(f());
#expect
try,catch:x

#name a catch scope is per iteration
#code
var out = [];
for (var i = 0; i < 50; i++) {
  try { throw "e" + i; } catch (e) { out.push(e); }
}
console.log(out.length, out[0], out[49]);
#expect
50 e0 e49

#name an arguments object outlives the call
#code
function grab() { return arguments; }
var args = grab(1, 2, 3);
console.log(args.length, args[0], args[2]);
function tail(x) { var a = arguments; return function () { return a.length + ":" + x; }; }
var t = tail("t");
console.log(t());
#expect
3 1 3
1:t

#name a direct eval sees the caller's bindings afterwards
#code
function scope() {
  var local = "L";
  var made = eval("(function () { return local + '!'; })");
  return made;
}
console.log(scope()());
#expect
L!

#name a private field survives collections
#code
class Point {
  #x = 0;
  #y = 0;
  constructor(x, y) { this.#x = x; this.#y = y; }
  sum() { return this.#x + this.#y; }
  bump() { this.#x += 1; return this.sum(); }
}
var p = new Point(3, 4);
console.log(p.sum());
for (var i = 0; i < 100; i++) p.bump();
console.log(p.sum());
#expect
7
107
