var o = document.getElementById('off'), n = 0;
o.addEventListener('click', function () { n++; });
document.getElementById('f').addEventListener('click', function () { n += 10; });
o.click();
console.log(n, o.disabled, o.matches(':disabled'));
o.disabled = false; o.click();
console.log(n);
#expect
0 true true
11

