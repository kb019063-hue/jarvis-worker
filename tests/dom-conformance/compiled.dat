true true false undefined
true true true 3
3 true
constructed | constructed | constructed | whenDefined true true

#name a class on a compiled constructor upgrades an element of the page
#html
<html><head><title>Upgrade</title></head><body><x-modern id="m" label="from the page"></x-modern><div id="host"></div></body></html>
#code
function Old() { var self = Reflect.construct(HTMLElement, [], new.target); self.made = new.target.name; return self; }
Old.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Old, writable: true, configurable: true } });
Old.prototype.hello = function () { return 'hello ' + this.getAttribute('label'); };
Object.setPrototypeOf(Old, HTMLElement);
class Modern extends Old {
  field = 7;
  #secret = 'kept';
  constructor() { var s = super(); this.same = s === this; this.top = new.target === Modern; }
  get secret() { return this.#secret; }
}
customElements.define('x-modern', Modern);
var m = document.getElementById('m');
console.log(m instanceof Modern, m instanceof Old, m.made, m.field, m.same, m.top, m.secret, m.hello());
var host = document.getElementById('host');
host.innerHTML = '<x-modern label="inner"></x-modern>';
console.log(host.firstChild.field, host.firstChild.secret, host.firstChild.hello(), host.firstChild.cloneNode(false).made);
#expect
true true Modern 7 true true kept hello from the page
7 kept hello inner Modern

