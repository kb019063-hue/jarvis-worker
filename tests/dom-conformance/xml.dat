#fixture
<html><head><title>XML</title></head><body><div id="host"></div></body></html>

#name DOMParser makes an XML document
#code
var d = new DOMParser().parseFromString('<a><b id="k">t</b><c/></a>', 'application/xml');
var root = d.documentElement;
console.log(d.nodeType, d.nodeName, d.contentType, d.characterSet, d.compatMode, d.URL === document.URL, d.doctype, d.childNodes.length);
console.log(root.nodeType, root.nodeName, root.tagName, root.localName, root.prefix, root.namespaceURI, root.constructor === Element, root instanceof HTMLElement);
console.log(d.querySelector('b').textContent, d.getElementById('k').nodeName, root.children.length, root.lastChild.childNodes.length);
console.log(new XMLSerializer().serializeToString(d));
console.log(d instanceof Document, d.defaultView, d.readyState, d !== document, root.ownerDocument === d);
#expect
9 #document application/xml UTF-8 CSS1Compat true null 1
1 a a a null null true false
t b 2 0
<a><b id="k">t</b><c/></a>
true null complete true true

#name the types DOMParser takes
#code
['text/xml', 'application/xml', 'application/xhtml+xml', 'image/svg+xml'].forEach(function (type) {
    var d = new DOMParser().parseFromString('<svg xmlns="http://www.w3.org/2000/svg"><title>t</title></svg>', type);
    console.log(d.contentType, d.documentElement.constructor.name, d.documentElement.firstChild.constructor.name, d.documentElement.namespaceURI);
});
['text/plain', 'application/json', 'TEXT/XML', '', 'text/xml; charset=utf-8'].forEach(function (type) {
    try { new DOMParser().parseFromString('<a/>', type); console.log(type, 'accepted'); }
    catch (e) { console.log(JSON.stringify(type), e.name, e instanceof TypeError); }
});
