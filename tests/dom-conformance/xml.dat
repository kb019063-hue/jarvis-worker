var e = document.createElement('div');
e.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:lang="en" viewBox="0 0 1 1"><use xlink:href="#a" xlink:title="t"/><a XLINK:HREF="#b" definitionurl="d"></a></svg><math definitionurl="u" xlink:show="new"></math>';
var svg = e.firstChild, use = svg.firstChild, a = svg.lastChild, math = e.lastChild;
console.log(use.getAttribute('xlink:href'), use.getAttributeNS('http://www.w3.org/1999/xlink', 'href'), use.hasAttribute('xlink:href'), use.hasAttributeNS('http://www.w3.org/1999/xlink', 'title'), use.getAttributeNames().join());
console.log(Array.prototype.map.call(svg.attributes, function (attr) { return [attr.name, attr.namespaceURI, attr.prefix, attr.localName].join('|'); }).join(' '));
console.log(Array.prototype.map.call(a.attributes, function (attr) { return [attr.name, attr.namespaceURI, attr.prefix, attr.localName].join('|'); }).join(' '));
console.log(Array.prototype.map.call(math.attributes, function (attr) { return [attr.name, attr.namespaceURI, attr.prefix, attr.localName].join('|'); }).join(' '));
console.log(e.innerHTML);
console.log(new XMLSerializer().serializeToString(svg));
var copy = svg.cloneNode(true);
console.log(copy.firstChild.getAttributeNS('http://www.w3.org/1999/xlink', 'href'), copy.attributes[1].namespaceURI, copy.outerHTML === svg.outerHTML);
use.setAttribute('xlink:href', '#c');
use.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:role', 'r');
use.removeAttributeNS('http://www.w3.org/1999/xlink', 'title');
console.log(use.outerHTML, use.getAttributeNS('http://www.w3.org/1999/xlink', 'href'), e.querySelectorAll('[xlink\\:href]').length);
var again = document.createElement('div');
again.innerHTML = e.innerHTML;
console.log(again.innerHTML === e.innerHTML, again.firstChild.firstChild.getAttributeNS('http://www.w3.org/1999/xlink', 'href'));
