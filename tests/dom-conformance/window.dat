#fixture
<html><head><title>Window</title></head><body><div id="byid">by id</div><p id="p" name="named">p</p><form name="search" id="sform"></form><div id="location">shadowed</div><div id="two-words">dash</div></body></html>

#name window, self, globalThis, this, top, parent, frames
#code
console.log(window === self, window === globalThis, window === this, window.window === window, window === top, window === parent, window === frames, window.frameElement, window.length, typeof window, window instanceof Window, window instanceof EventTarget);
#expect
true true true true true true true null 0 object true true

#name global variables are window properties and back
#code
var declared = 1;
window.assigned = 2;
implicit = 3;
function fn() { return 4; }
console.log(window.declared, assigned, window.implicit, window.fn(), 'declared' in window, 'nosuch' in window, window.nosuch, typeof nosuch);
try { nosuch; } catch (e) { console.log(e.name); }
let lexical = 5; const fixed = 6;
console.log(window.lexical, window.fixed, lexical + fixed);
#expect
1 2 3 4 true false undefined undefined
ReferenceError
undefined undefined 11

#name deleting and redefining globals
#code
window.temp = 1;
console.log(delete window.temp, typeof temp, 'temp' in window);
window.temp = 2;
console.log(temp);
#expect
true undefined false
2

#name elements with an id are globals unless something else has the name
#code
console.log(byid === document.getElementById('byid'), window.byid.textContent, typeof p, window['two-words'].textContent, location === window.location, typeof location.href, 'byid' in window);
window.byid = 'now a variable';
console.log(byid, window.byid, document.getElementById('byid').id);
console.log(search === document.forms.search, window.sform === document.getElementById('sform'));
#expect
true by id object dash true string true
now a variable now a variable byid
true true

