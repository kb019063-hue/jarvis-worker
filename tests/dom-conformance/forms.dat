var f = document.getElementById('f');
console.log(document.getElementById('user').form === f, document.getElementById('go').form === f, document.getElementById('color').form === f, document.getElementById('note').form === f, document.getElementById('outside').form === f, document.getElementById('inside').form, document.getElementById('color').options[0].form === f, document.createElement('input').form);
#expect
true true true true true null true null

#name select: value, selectedIndex and options
#code
var c = document.getElementById('color');
console.log(c.value, c.selectedIndex, c.options.length, c.length, c.options[2].value, c.options[2].text, c.type, c.multiple, c.selectedOptions.length);
c.value = 'r';
console.log(c.selectedIndex, c.options[0].selected, c.options[1].selected, c.options[1].hasAttribute('selected'), c.options[1].defaultSelected);
c.selectedIndex = 2;
console.log(c.value, c.options[2].selected);
c.value = 'nosuch';
console.log(c.selectedIndex, JSON.stringify(c.value));
c.selectedIndex = -1; console.log(JSON.stringify(c.value));
c.selectedIndex = 99; console.log(c.selectedIndex);
#expect
g 1 3 3 Blue Blue select-one false 1
0 true false true true
Blue true
-1 ""
""
-1

#name a select with nothing marked selects its first option
#code
var s = document.createElement('select');
s.innerHTML = '<option value="1" disabled>one</option><option value="2">two</option><option value="3">three</option>';
console.log(s.selectedIndex, s.value, s.options[1].selected);
var t = document.createElement('select');
console.log(t.selectedIndex, JSON.stringify(t.value));
t.add(new Option('Late', 'late'));
console.log(t.selectedIndex, t.value);
#expect
1 2 true
-1 ""
0 late

#name option: text, value, label, index, selected
#code
var c = document.getElementById('color');
var o = c.options[2];
console.log(o.value, o.text, o.label, o.index, o.selected, o.defaultSelected, o.disabled, o.hasAttribute('value'));
o.selected = true;
console.log(c.value, c.selectedIndex, c.options[1].selected);
o.value = 'b'; o.text = 'Navy';
console.log(o.getAttribute('value'), o.textContent, c.value, o.label);
var n = new Option('Text', 'val', true, true);
console.log(n.text, n.value, n.defaultSelected, n.selected, n.tagName, n.hasAttribute('selected'), new Option().text === '');
#expect
Blue Blue Blue 2 false false false false
Blue 2 false
b Navy b Navy
Text val true true OPTION true true

#name adding and removing options
#code
var c = document.getElementById('color');
c.add(new Option('Pink', 'p'));
c.add(new Option('First', 'f'), 0);
c.add(new Option('Before green', 'bg'), c.options[2]);
console.log(Array.from(c.options).map(function (o) { return o.value; }).join(','), c.value, c.selectedIndex);
c.remove(0);
c.options[0].remove();
console.log(c.length, c.value, c.selectedIndex);
c.options.length = 2;
console.log(c.length, c.value);
c.innerHTML = '';
console.log(c.length, c.selectedIndex, JSON.stringify(c.value));
#expect
f,r,bg,g,Blue,p g 3
4 g 1
2 g
0 -1 ""

#name a multiple select
#code
var t = document.getElementById('tags');
console.log(t.type, t.value, t.selectedIndex, t.selectedOptions.length, Array.from(t.selectedOptions).map(function (o) { return o.value; }).join(''));
t.options[1].selected = true; t.options[0].selected = false;
console.log(t.value, t.selectedIndex, t.selectedOptions.length);
t.value = 'c';
console.log(Array.from(t.options).map(function (o) { return o.selected; }).join(','));
t.selectedIndex = -1;
