function 8 true 5 undefined 1

#name new.target whose prototype is not an object: the default prototype is used
#code
function F() {}
function G() {}
G.prototype = null;
function H() {}
H.prototype = 5;
var o = Reflect.construct(F, [], G), a = Reflect.construct(Array, [], H), e = Reflect.construct(Error, ['m'], G);
class K {}
var k = Reflect.construct(K, [], G);
console.log(Object.getPrototypeOf(o) === Object.prototype, Object.getPrototypeOf(a) === Array.prototype, Array.isArray(a),
            Object.getPrototypeOf(e) === Error.prototype, e.message, Object.getPrototypeOf(k) === Object.prototype);
#expect
true true true true m true

#name the prototype is read from new.target once, before the constructor's own code
#code
var reads = 0, proto = {tag: 'P'};
function accessor() { var nt = function () {}.bind(null); Object.defineProperty(nt, 'prototype', { get: function () { reads++; return proto; } }); return nt; }
function F() { this.readsInside = reads; }
var o = Reflect.construct(F, [], accessor());
var first = reads;
class A { constructor() { this.readsInside = reads; } }
class B extends A {}
var b = Reflect.construct(B, [], accessor());
var second = reads;
var a = Reflect.construct(Array, [2], accessor());
console.log(first, o.tag, o.readsInside, second, b.tag, b.readsInside, reads, a.tag, a.length);
#expect
1 P 1 2 P 2 3 P 2

#name an object a parent function returns is this in the child
#code
var registry = [];
function Parent() { var o = {from: 'parent'}; registry.push(o); return o; }
class Child extends Parent {
  constructor() { var before = super(); this.own = 2; this.same = before === this; }
}
var c = new Child();
console.log(c === registry[0], c.from, c.own, c.same, c instanceof Child, Object.getPrototypeOf(c) === Object.prototype);
#expect
true parent 2 true false true

#name an object a parent class returns is this in the child, through two levels
#code
var made = {tag: 'made'};
class A { constructor() { this.lost = true; return made; } }
class B extends A { constructor() { super(); this.b = 1; } }
class C extends B { constructor() { super(); this.c = 2; } }
var c = new C();
console.log(c === made, c.b, c.c, 'lost' in c, c instanceof C, c.tag);
#expect
true 1 2 false false made

#name the fields of a child go on the object its parent returned
#code
class Parent { constructor(target) { return target; } }
class Child extends Parent {
  count = 7;
  label = 'on ' + (this === store ? 'the returned object' : 'another object');
  #secret = 42;
  reveal() { return this.#secret; }
  static reveal(o) { return o.#secret; }
}
var store = {};
var c = new Child(store);
console.log(c === store, store.count, store.label, Child.reveal(store), typeof store.reveal, Object.keys(store).join());
#expect
true 7 on the returned object 42 undefined count,label

#name the value of super() is this
#code
class A { constructor() { this.a = 1; } }
class B extends A { constructor() { var s = super(); this.same = s === this; s.viaSuper = true; } }
class M extends Map { constructor() { var s = super(); this.same = s === this; } }
class E extends Error { constructor() { var s = super('m'); this.same = s === this; } }
var b = new B();
console.log(b.same, b.viaSuper, b.a, new M().same, new E().same);
#expect
true true 1 true true

#name a parent returns a function or an array: that is the instance
#code
function callable() { return 'called'; }
class F { constructor() { return callable; } }
class G extends F { extra = 1; constructor() { super(); this.more = 2; } }
var g = new G();
class Arr { constructor() { return [1, 2]; } }
class Stack extends Arr { constructor() { super(); this.push(3); } }
var s = new Stack();
console.log(g === callable, g(), g.extra, g.more, typeof g, Array.isArray(s), s.length, s.join('-'), s instanceof Stack);
delete callable.extra; delete callable.more;
#expect
true called 1 2 function true 3 1-2-3 false

#name a parent that returns a primitive: the return value is ignored
