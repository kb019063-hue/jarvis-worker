3 1 2 3 true true true true true

#name an element of the page is upgraded by an ES5 constructor
#html
<html><head><title>Upgrade</title></head><body><x-old id="parsed" start="3">text</x-old><x-old id="bare"></x-old><div id="host"></div></body></html>
#code
var log = [];
function Old() { var self = Reflect.construct(HTMLElement, [], new.target); self.made = true; log.push('constructed ' + self.id + ' ' + self.getAttribute('start') + ' ' + self.childNodes.length + ' ' + self.isConnected); return self; }
Old.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Old, writable: true, configurable: true } });
Old.prototype.connectedCallback = function () { log.push('connected ' + this.id); };
Old.prototype.attributeChangedCallback = function (name, before, after) { log.push(this.id + ' ' + name + ':' + before + '>' + after); };
Old.observedAttributes = ['start'];
Object.setPrototypeOf(Old, HTMLElement);
var e = document.getElementById('parsed');
console.log(e instanceof HTMLElement, e.constructor === HTMLElement, e.made, e.matches(':defined'));
customElements.define('x-old', Old);
console.log(e instanceof Old, e.constructor === Old, e.made, e.matches(':defined'), document.getElementById('bare').made, e === document.getElementById('parsed'));
console.log(log.join(' | '));
e.setAttribute('start', '4');
console.log(log[log.length - 1], e.textContent, document.querySelectorAll('x-old:defined').length);
#expect
true true undefined false
true true true true true true
constructed parsed 3 1 true | parsed start:null>3 | connected parsed | constructed bare null 0 true | connected bare
parsed start:3>4 text 2

#name innerHTML and cloneNode make elements that an ES5 constructor upgrades
#code
var log = [];
function Old() { var self = Reflect.construct(HTMLElement, [], new.target); self.n = log.length; log.push('constructed ' + self.id + ' ' + self.isConnected); return self; }
Old.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Old, writable: true, configurable: true } });
Old.prototype.connectedCallback = function () { log.push('connected ' + this.id); };
Object.setPrototypeOf(Old, HTMLElement);
customElements.define('x-old', Old);
var host = document.getElementById('host');
host.innerHTML = '<x-old id="one"></x-old><p><x-old id="two"></x-old></p>';
var one = document.getElementById('one'), two = document.getElementById('two');
console.log(one instanceof Old, one.n, two instanceof Old, two.n);
var copy = one.cloneNode(true), deep = host.cloneNode(true);
console.log(copy instanceof Old, copy.n, copy !== one, copy.id, deep.querySelector('p x-old') instanceof Old, typeof deep.querySelector('p x-old').n);
console.log(log.join(' | '));
host.appendChild(copy);
console.log(log[log.length - 1], host.querySelectorAll('x-old').length);
#expect
true 0 true 2
true 4 true one true number
constructed one true | connected one | constructed two true | connected two | constructed one false | constructed one false | constructed two false
connected one 3

#name customElements.upgrade and whenDefined with an ES5 constructor
#html
<html><head><title>Upgrade</title></head><body><x-late id="late"></x-late><div id="host"></div></body></html>
#code
var late = document.getElementById('late'), order = [];
customElements.whenDefined('x-late').then(function (ctor) { order.push('whenDefined ' + (ctor === Late) + ' ' + late.made); console.log(order.join(' | ')); });
function Late() { var self = Reflect.construct(HTMLElement, [], new.target); self.made = true; order.push('constructed'); return self; }
Late.prototype = Object.create(HTMLElement.prototype, { constructor: { value: Late, writable: true, configurable: true } });
Object.setPrototypeOf(Late, HTMLElement);
var tree = document.createElement('section');
tree.innerHTML = '<x-late></x-late><b><x-late></x-late></b>';
customElements.define('x-late', Late);
console.log(late instanceof Late, late.made, tree.firstChild instanceof Late, tree.firstChild.made);
customElements.upgrade(tree);
console.log(tree.firstChild instanceof Late, tree.firstChild.made, tree.querySelector('b x-late').made, order.length);
customElements.upgrade(tree);
