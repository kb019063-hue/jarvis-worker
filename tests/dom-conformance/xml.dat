#name text that is not well formed gives a document that says so
#code
var NS = 'http://www.mozilla.org/newlayout/xml/parsererror.xml';
function report(text) {
    var d = new DOMParser().parseFromString(text, 'application/xml');
    var e = d.documentElement;
    return [e.localName === 'parsererror' && e.namespaceURI === NS ? 'error' : 'ok:' + e.nodeName, d.childNodes.length, d.getElementsByTagNameNS(NS, 'parsererror').length].join(' ');
}
['<a><b></a>', '<a>', '', 'text', '<a/><b/>', '<a b=1/>', '<a b="1" b="2"/>', '<p:a/>', '<a><!-- -- --></a>', '<a><?xml v?></a>', '<a>]]></a>', '<a b="<"/>', '<1a/>', '<a></A>', '<?xml version="1.0"?>\n<a/>', '\n<?xml version="1.0"?><a/>', '<a xmlns:xml="urn:x"/>', '<a xmlns:p=""/>', '<a>\u0001</a>', '<a/>x', '<a/><!--ok--><?ok?> ', '<a b="1"c="2"/>', '<a/ >', '< a/>', '<a><![CDATA[x]]></a>', '<a><![CDATA[x]></a>', '<![CDATA[x]]><a/>', '<a xmlns:p="u" xmlns:q="u" p:x="1" q:x="2"/>', '<a xml:lang="en"/>', '<xmlns:a xmlns:xmlns="u"/>', '<a:b xmlns:a="u"><a:c/></a:b>', '<a><b/><b/></a><?x?><!--y-->', '<!DOCTYPE a><!DOCTYPE a><a/>', '<a><!DOCTYPE a></a>', '<?xml version="1.0" standalone="maybe"?><a/>', '<a>\ufffe</a>', '<a\u00a0b="1"/>', '<\u00e9t\u00e9 \u00e0="1"/>', '<a>&#x41;&#66;</a>', '<a b="&#x41;" />'].forEach(function (text) {
    console.log(JSON.stringify(text), report(text));
});
var bad = new DOMParser().parseFromString('<a><b></a>', 'text/xml');
console.log(bad.contentType, bad.documentElement.childNodes.length > 0, bad.documentElement.textContent.length > 0, bad.querySelector('a'), bad.querySelector('parsererror') === bad.documentElement);
