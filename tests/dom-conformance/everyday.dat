#fixture
<html><head><title>Everyday</title><style>.hide { display: none } .box { margin: 4px }</style></head>
<body>
<div id="main" class="box wide">
  <h1 class="title">Hello</h1>
  <ul id="list"><li class="item first">One</li><li class="item">Two</li><li class="item last" tabindex="3">Three</li></ul>
  <p class="text">Some <b>bold</b> text</p>
  <form id="form"><input type="text" name="user" value="ann"><input type="checkbox" name="ok" value="yes" checked><select name="pick"><option value="a">A</option><option value="b" selected>B</option></select><select name="many" multiple><option value="x" selected>X</option><option value="y">Y</option><option value="z" selected>Z</option></select></form>
</div>
<div id="other"><span class="item">Span</span></div>
</body></html>

