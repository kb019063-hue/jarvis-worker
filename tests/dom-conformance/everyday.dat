#name effects/toggle: style.display twice
#code
function toggle(el) {
  if (el.style.display == 'none') {
    el.style.display = '';
  } else {
    el.style.display = 'none';
  }
}
var el = document.querySelector('.title');
toggle(el); console.log(JSON.stringify(el.style.display));
toggle(el); console.log(JSON.stringify(el.style.display));
#expect
"none"
""

