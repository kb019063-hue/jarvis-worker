MouseEvent < UIEvent < Event | KeyboardEvent < UIEvent < Event | CustomEvent < Event
PointerEvent < MouseEvent < UIEvent < Event | WheelEvent < MouseEvent < UIEvent < Event | FocusEvent < UIEvent < Event | InputEvent < UIEvent < Event
SubmitEvent < Event | ProgressEvent < Event | HashChangeEvent < Event | PopStateEvent < Event
ErrorEvent < Event | MessageEvent < Event | StorageEvent < Event | CompositionEvent < UIEvent < Event | TouchEvent < UIEvent < Event
CloseEvent < Event | PageTransitionEvent < Event | BeforeUnloadEvent < Event | TransitionEvent < Event | PromiseRejectionEvent < Event

#name interface objects that are not nodes or events
#code
function chain(c) { var names = []; while (typeof c === 'function' && c.name && names.length < 12) { names.push(c.name); c = Object.getPrototypeOf(c); } return names.join(' < '); }

console.log(chain(XMLHttpRequest), '|', chain(XMLHttpRequestUpload), '|', chain(AbortSignal));
console.log(chain(RadioNodeList), '|', chain(HTMLFormControlsCollection), '|', chain(HTMLOptionsCollection), '|', chain(HTMLCollection), '|', chain(NodeList));
console.log(chain(Range), '|', chain(DOMException), '|', chain(DOMRect), '|', chain(File), '|', chain(EventTarget), '|', chain(Event));
console.log(chain(Window), '|', chain(Selection), '|', chain(MutationObserver), '|', chain(DOMTokenList), '|', chain(NamedNodeMap), '|', chain(DOMParser), '|', chain(XMLSerializer));
