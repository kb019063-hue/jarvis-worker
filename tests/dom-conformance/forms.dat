#name input and change events come from user-like actions, not from setting value
#code
var u = document.getElementById('user'), n = document.getElementById('news');
var log = [];
['input', 'change'].forEach(function (t) { document.getElementById('f').addEventListener(t, function (e) { log.push(t + '@' + e.target.id); }); });
u.value = 'set by script'; n.checked = false; document.getElementById('color').value = 'r';
console.log(log.length);
n.click();
document.getElementById('small').click();
console.log(log.join(' '));
u.dispatchEvent(new Event('input', {bubbles: true}));
console.log(log[log.length - 1]);
#expect
0
input@news change@news input@small change@small
input@user

#name clicking a radio that is already checked fires nothing more
