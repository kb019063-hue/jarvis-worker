TypeError | TypeError | TypeError | TypeError a,b

#name the string iterator method is given a string, not an object
#code
var original = String.prototype[Symbol.iterator]; var seen;
String.prototype[Symbol.iterator] = function () { 'use strict'; seen = typeof this; return original.call(this); };
var s = [...'ab'];
String.prototype[Symbol.iterator] = original;
console.log(s.join(), seen);
#expect
a,b string

#name strings iterate by code point
#code
var s = 'a\u{1F600}b\uD800c';
console.log([...s].length, Array.from(s).map(function (c) { return c.length; }).join(), [...new String('xy')].join(), [...''].length);
