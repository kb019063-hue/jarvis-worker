HTMLBodyElement HTMLHeadElement DIV HTMLUnknownElement
0 1 0 1 0 1
<html xmlns="http://www.w3.org/1999/xhtml"><head><title>T</title></head><body><p class="x">hi<br /></p><DIV></DIV></body></html>

#name comments, processing instructions, CDATA sections and the doctype are nodes
#code
var d = new DOMParser().parseFromString('<?xml version="1.0" encoding="UTF-8"?><!--c1--><?pi some data?><!DOCTYPE a><a>x<![CDATA[<raw>&amp;]]>y<!--c2--><?t?><b> </b></a><!--c3-->', 'text/xml');
function kind(n) { return n.nodeType + ' ' + n.nodeName + ' ' + n.constructor.name + ' ' + JSON.stringify(n.nodeValue); }
console.log(d.childNodes.length);
for (var i = 0; i < d.childNodes.length; i++) console.log(kind(d.childNodes[i]));
var a = d.documentElement;
for (i = 0; i < a.childNodes.length; i++) console.log(kind(a.childNodes[i]));
var cdata = a.childNodes[1], pi = d.childNodes[1];
console.log(JSON.stringify(a.textContent), pi.target, pi.data, cdata.data, cdata.length, cdata.wholeText, cdata instanceof Text, cdata instanceof CharacterData, pi instanceof CharacterData, pi instanceof Text);
console.log(a.childNodes[4].target, JSON.stringify(a.childNodes[4].data), Node.CDATA_SECTION_NODE, Node.PROCESSING_INSTRUCTION_NODE);
console.log(new XMLSerializer().serializeToString(d));
