#name overrideMimeType puts another type in place of the response's
#code
var cases = [['data:text/plain,<a/>', 'text/xml'], ['data:text/plain,<a/>', 'application/vnd.x+xml'], ['data:text/xml,<a/>', 'text/plain'],
             ['data:text/xml,<a/>', 'rubbish'], ['data:text/xml,<a/>', ''], ['data:text/xml,<a/>', ' TEXT/XML '],
             ['data:text/plain;charset=iso-8859-1,%E9', 'text/plain;charset=utf-8'], ['data:text/plain;charset=utf-8,%E9', 'text/plain;charset=iso-8859-1'],
             ['data:text/plain;charset=iso-8859-1,%E9', 'text/plain']];
var at = 0;
(function next() {
    if (at === cases.length) return;
    var c = cases[at++], x = new XMLHttpRequest();
    x.overrideMimeType(c[1]);
    x.onloadend = function () {
        console.log(JSON.stringify(c[1]), x.responseText.charCodeAt(0), x.responseXML ? x.responseXML.documentElement.nodeName : String(x.responseXML), x.getResponseHeader('content-type'));
        next();
    };
    x.open('GET', c[0]);
    x.send();
})();
