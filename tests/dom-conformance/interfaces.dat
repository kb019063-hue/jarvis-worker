#fixture
<html><head><title>Interfaces</title></head><body><div id="a"><p>x</p><input id="i"><svg id="s"></svg></div></body></html>

#name the interface object of an element has its parent's as prototype, up to EventTarget
#code
function chain(c) { var names = []; while (typeof c === 'function' && c.name && names.length < 12) { names.push(c.name); c = Object.getPrototypeOf(c); } return names.join(' < '); }

console.log(chain(HTMLDivElement));
console.log(chain(HTMLInputElement));
console.log(chain(HTMLUnknownElement));
console.log(chain(SVGSVGElement));
console.log(chain(document.createElement('video').constructor));
console.log(chain(document.createElement('a').constructor), '|', chain(document.createElement('nosuch').constructor));
#expect
HTMLDivElement < HTMLElement < Element < Node < EventTarget
HTMLInputElement < HTMLElement < Element < Node < EventTarget
HTMLUnknownElement < HTMLElement < Element < Node < EventTarget
SVGSVGElement < SVGGraphicsElement < SVGElement < Element < Node < EventTarget
HTMLVideoElement < HTMLMediaElement < HTMLElement < Element < Node < EventTarget
HTMLAnchorElement < HTMLElement < Element < Node < EventTarget | HTMLUnknownElement < HTMLElement < Element < Node < EventTarget

#name the interface objects of nodes that are not elements
#code
function chain(c) { var names = []; while (typeof c === 'function' && c.name && names.length < 12) { names.push(c.name); c = Object.getPrototypeOf(c); } return names.join(' < '); }

console.log(chain(Text), '|', chain(Comment), '|', chain(CDATASection), '|', chain(ProcessingInstruction));
console.log(chain(Document), '|', chain(XMLDocument), '|', chain(DocumentFragment), '|', chain(ShadowRoot));
console.log(chain(Attr), '|', chain(DocumentType), '|', chain(CharacterData));
#expect
Text < CharacterData < Node < EventTarget | Comment < CharacterData < Node < EventTarget | CDATASection < Text < CharacterData < Node < EventTarget | ProcessingInstruction < CharacterData < Node < EventTarget
Document < Node < EventTarget | XMLDocument < Document < Node < EventTarget | DocumentFragment < Node < EventTarget | ShadowRoot < DocumentFragment < Node < EventTarget
Attr < Node < EventTarget | DocumentType < Node < EventTarget | CharacterData < Node < EventTarget

#name the interface objects of events
#code
function chain(c) { var names = []; while (typeof c === 'function' && c.name && names.length < 12) { names.push(c.name); c = Object.getPrototypeOf(c); } return names.join(' < '); }

console.log(chain(MouseEvent), '|', chain(KeyboardEvent), '|', chain(CustomEvent));
console.log(chain(PointerEvent), '|', chain(WheelEvent), '|', chain(FocusEvent), '|', chain(InputEvent));
console.log(chain(SubmitEvent), '|', chain(ProgressEvent), '|', chain(HashChangeEvent), '|', chain(PopStateEvent));
console.log(chain(ErrorEvent), '|', chain(MessageEvent), '|', chain(StorageEvent), '|', chain(CompositionEvent), '|', chain(TouchEvent));
console.log(chain(CloseEvent), '|', chain(PageTransitionEvent), '|', chain(BeforeUnloadEvent), '|', chain(TransitionEvent), '|', chain(PromiseRejectionEvent));
