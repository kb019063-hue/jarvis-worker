#name getComputedStyle: the most specific rule wins, then the later one
#html
<!DOCTYPE html><html><head><title>t</title><style>
#p { color: rgb(1, 1, 1) } p { color: rgb(2, 2, 2) }
.k.k { margin-top: 3px } .k { margin-top: 4px }
p { padding-top: 5px !important } #p { padding-top: 6px }
:where(#p) { top: 7px } p { top: 8px }
:is(#p, i) { left: 9px } p.k { left: 10px }
p:not(.none) { right: 11px } p { right: 12px }
[id] { bottom: 13px } p { bottom: 14px }
p { width: 15px } p { width: 16px }
div p { height: 17px } p { height: 18px }
body > p.k { min-width: 19px } p.k { min-width: 20px }
p:first-child { max-width: 21px } p { max-width: 22px }
.imp { margin-left: 23px !important; padding-left: 24px !important } #q { margin-left: 25px }
* { text-indent: 26px } i { text-indent: 27px }
</style></head><body><p id="p" class="k">x</p><div><p id="q" class="imp" style="margin-left: 28px; padding-left: 29px !important; margin-right: 30px">y</p><i id="i">z</i></div></body></html>
#code
var p = getComputedStyle(document.getElementById('p'));
console.log(p.color, p.marginTop, p.paddingTop, p.top, p.left, p.right, p.bottom, p.width, p.height, p.minWidth, p.maxWidth);
var q = getComputedStyle(document.getElementById('q'));
console.log(q.height, q.marginLeft, q.paddingLeft, q.marginRight, q.textIndent, getComputedStyle(document.getElementById('i')).textIndent);
#expect
rgb(1, 1, 1) 3px 5px 8px 9px 11px 13px 16px 18px 19px 21px
17px 23px 29px 30px 26px 27px

#name getComputedStyle: a colour comes back as rgb()
#html
<!DOCTYPE html><html><head><title>t</title><style>
#a { color: red; background-color: #0f0; border: 2px solid; outline-color: rebeccapurple }
#b { color: hsl(120, 100%, 25%); background-color: transparent; border-top: 1px dashed currentcolor }
#c { color: #11223380; background-color: rgba(10, 20, 30, 0.5); border-left: 3px solid navy }
#d { color: currentcolor; background-color: papayawhip }
</style></head><body><div id="a"><span id="a1">x</span><div id="b"><i id="b1">y</i></div></div><div id="c"><p id="d">z</p></div></body></html>
#code
function cs(id) { return getComputedStyle(document.getElementById(id)); }
var a = cs('a');
console.log(a.color, '|', a.backgroundColor, '|', a.borderTopColor, '|', a.borderColor, '|', a.outlineColor);
console.log(cs('a1').color, '|', cs('a1').backgroundColor, '|', cs('a1').borderTopColor);
var b = cs('b');
console.log(b.color, '|', b.backgroundColor, '|', b.borderTopColor, '|', b.borderLeftColor, '|', cs('b1').color);
var c = cs('c');
console.log(c.color, '|', c.backgroundColor, '|', c.borderLeftColor, '|', c.borderRightColor);
console.log(cs('d').color, '|', cs('d').backgroundColor, '|', cs('d').borderBottomColor);
var el = document.getElementById('d');
['Blue', 'ORANGE', 'gray', 'grey', 'lightgoldenrodyellow', 'white', 'black', 'tomato'].forEach(function (name) {
    el.style.color = name;
    console.log(name, getComputedStyle(el).color);
});
#expect
rgb(255, 0, 0) | rgb(0, 255, 0) | rgb(255, 0, 0) | rgb(255, 0, 0) | rgb(102, 51, 153)
rgb(255, 0, 0) | rgba(0, 0, 0, 0) | rgb(255, 0, 0)
rgb(0, 128, 0) | rgba(0, 0, 0, 0) | rgb(0, 128, 0) | rgb(0, 128, 0) | rgb(0, 128, 0)
rgba(17, 34, 51, 0.5) | rgba(10, 20, 30, 0.5) | rgb(0, 0, 128) | rgba(17, 34, 51, 0.5)
rgba(17, 34, 51, 0.5) | rgb(255, 239, 213) | rgba(17, 34, 51, 0.5)
Blue rgb(0, 0, 255)
ORANGE rgb(255, 165, 0)
gray rgb(128, 128, 128)
grey rgb(128, 128, 128)
lightgoldenrodyellow rgb(250, 250, 210)
white rgb(255, 255, 255)
black rgb(0, 0, 0)
tomato rgb(255, 99, 71)

