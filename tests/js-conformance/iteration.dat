1,2,3 3 2 false

#name arguments has a Symbol.iterator of its own
#code
function h() { return [typeof arguments[Symbol.iterator], arguments[Symbol.iterator] === Array.prototype[Symbol.iterator], Object.prototype.hasOwnProperty.call(arguments, Symbol.iterator), Object.getOwnPropertySymbols(arguments).length].join(); }
console.log(h(1, 2));
#expect
function,true,true,1

#name a String.prototype method called on an array, the string iterator among them
#code
var a = ['x', 'y']; a[Symbol.iterator] = String.prototype[Symbol.iterator];
console.log([...a].join('+'), String.prototype.trim.call(['x', 'y']), String.prototype[Symbol.iterator].call(['p', 'q']).next().value);
#expect
x+,+y x,y p

#name the default constructor of a subclass does not iterate its arguments
#code
var original = Array.prototype[Symbol.iterator]; var calls = 0;
Array.prototype[Symbol.iterator] = function () { calls++; return original.call(this); };
class Base { constructor(a, b) { this.sum = a + b; this.count = arguments.length; } }
class Derived extends Base {}
class Further extends Derived {}
class Written extends Base { constructor(...args) { super(...args); } }
var d = new Derived(2, 3), f = new Further(4, 5, 6), before = calls, w = new Written(1, 1);
Array.prototype[Symbol.iterator] = original;
console.log(d.sum, d.count, f.sum, f.count, before, calls - before);
#expect
5 2 9 3 0 1

#name yield* in an async generator asks for Symbol.asyncIterator
#code
async function* inner() { yield 1; yield 2; }
async function* outer() { yield 0; yield* inner(); yield 3; }
var own = { [Symbol.asyncIterator]: function () { var i = 0; return { next: function () { return Promise.resolve(i < 3 ? { value: i++, done: false } : { done: true }); } }; } };
async function* over() { yield* own; }
async function collect(g) { var out = []; try { for await (var x of g) out.push(x); } catch (e) { out.push(e.constructor.name); } return out.join(); }
collect(outer()).then(function (a) { return collect(over()).then(function (b) { console.log(a, '|', b); }); });
#expect
0,1,2,3 | 0,1,2

#name Array.from maps as the values arrive, and a mapper that throws closes the iterator
#code
function t(f) { try { return String(f()); } catch (e) { return e.name; } }
var log = [];
var source = { [Symbol.iterator]: function () { var i = 0; return { next: function () { i++; return { value: i, done: false }; }, return: function () { log.push('closed at ' + i); return { done: true }; } }; } };
console.log(t(function () { return Array.from(source, function (v) { if (v === 3) throw new RangeError('stop'); return v; }); }), log.join(','));
#expect
RangeError closed at 3

#name Array.from reads a string that lost its iterator as array-like
#code
function t(f) { try { return String(f()); } catch (e) { return e.name; } }
var saved = String.prototype[Symbol.iterator];
delete String.prototype[Symbol.iterator];
var r = [t(function () { return Array.from('ab').join(); }), t(function () { return Array.from('\u{1F600}z').length; })];
String.prototype[Symbol.iterator] = saved;
console.log(r.join(' | '));
#expect
a,b | 3

#name Array.from takes a length as ToLength does, and maps an array-like too
#code
console.log(JSON.stringify(Array.from({ length: -1 })), Array.from({ length: '2' }, function (v) { return typeof v; }).join(), Array.from({ length: 2.9 }).length, Array.from({ length: undefined }).length);
#expect
[] undefined,undefined 2 0

#name Array.from refuses what is not callable, and reads a null iterator as none
#code
function t(f) { try { return String(f()); } catch (e) { return e.name; } }
console.log(t(function () { return Array.from({ [Symbol.iterator]: 5 }); }), t(function () { return Array.from({ [Symbol.iterator]: null, length: 2 }).length; }), t(function () { return Array.from(1, 2); }));
#expect
TypeError 2 TypeError

#name a pattern follows a string's iterator by code point, surrogate pairs and lone halves
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var [a, b, c] = '\u{1F600}z';
var [half, letter] = '\uD83D' + 'q';
var [one] = '\u{1F600}';
var [] = 'x';
console.log([a.length, b, c, half.length, letter, one.length, t(function () { var [q] = 5; return q; })].join(' | '));
#expect
2 | z |  | 1 | q | 2 | TypeError

#name IteratorClose: what return must be, and what a pattern does with it
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
function source(ret) { var o = {}; o[Symbol.iterator] = function () { return { next: function () { return { value: 1, done: false }; }, return: ret }; }; return o; }
var log = [];
var missing = {}; missing[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < 4 ? { value: i++, done: false } : { done: true }; } }; };
var [a, b] = missing;
var nul = {}; nul[Symbol.iterator] = function () { return { next: function () { return { value: 1, done: false }; }, return: null }; };
var r = [t(function () { var [q] = source(5); return q; }), t(function () { var [q] = source(function () { return 5; }); return q; }),
         t(function () { var [q] = source(function () { return {}; }); return q; }), t(function () { var [q] = source(function () { throw new RangeError('x'); }); return q; }),
         t(function () { var [q] = nul; return q; }), a, b, t(function () { var [] = missing; return 'drained'; })];
console.log(r.join());
#expect
TypeError,TypeError,1,RangeError,1,0,1,drained
