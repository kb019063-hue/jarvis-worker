#name eval of 200000 nested parentheses
#code
var depth = 200000, src = '('.repeat(depth) + '1' + ')'.repeat(depth);
var outcome;
try { eval(src); outcome = 'ran'; } catch (e) { outcome = e instanceof RangeError ? 'RangeError' : e.name; }
console.log(outcome === 'ran' || outcome === 'RangeError', 'still running', [1, 2, 3].map(function (x) { return x * 2; }).join())
#expect
true still running 2,4,6

