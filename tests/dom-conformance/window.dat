var l = location;
console.log(l.href, l.protocol, l.host, l.hostname, JSON.stringify(l.port), l.pathname, l.search, l.hash, l.origin, String(l), l.toString() === l.href, l instanceof Location, typeof l.assign, typeof l.replace, typeof l.reload);
