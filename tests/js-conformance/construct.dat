  function Base(id) { this.id = id; this.viaNew = new.target !== undefined; }
  Base.prototype.describe = function () { return 'item ' + this.id; };
  return Base;
})();
var Item = (function (_super) {
  __extends(Item, _super);
  function Item(id, tag) { var _this = _super.call(this, id) || this; _this.tag = tag; return _this; }
  return Item;
