#name an XHTML document: the interfaces of HTML, and names that keep their case
#code
var d = new DOMParser().parseFromString('<html xmlns="http://www.w3.org/1999/xhtml"><head><title>T</title></head><body><p class="x">hi<br/></p><DIV/></body></html>', 'application/xhtml+xml');
var p = d.querySelector('p');
console.log(d.documentElement.constructor.name, p.constructor.name, p.tagName, p.nodeName, p.className, d.title);
console.log(d.body.constructor.name, d.head.constructor.name, d.body.lastChild.tagName, d.body.lastChild.constructor.name);
console.log(d.querySelectorAll('div').length, d.querySelectorAll('DIV').length, d.getElementsByTagName('div').length, d.getElementsByTagName('DIV').length, d.getElementsByTagName('P').length, d.getElementsByTagName('p').length);
console.log(new XMLSerializer().serializeToString(d));
