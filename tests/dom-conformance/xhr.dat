 ['TRACE', 'data:,'], ['connect', 'data:,'], ['Track', 'data:,'], ['GET', 'http://[x'], ['GET', 'http://a b/'], ['GET', 'feed.xml'], ['GET', '']].forEach(function (c) {
    console.log(JSON.stringify(c[0]), JSON.stringify(c[1]), attempt(c[0], c[1]));
});
