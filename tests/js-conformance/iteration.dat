false undefined undefined undefined -1 false undefined TypeError

#name an object whose prototype is an array
#code
var o = Object.create([1, 2, 3]);
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
console.log(t(function () { return [...o].join(); }), o.length, o[1], Array.isArray(o));
