#name getComputedStyle: a shorthand in a rule answers for its parts
#html
<!DOCTYPE html><html><head><title>t</title><style>
#d { font: italic bold 12px/30px Georgia, serif; overflow: hidden auto; flex: 2 1 10em; gap: 1em 2px; inset: 1px 2px 3px; border-radius: 1em 2px; list-style: square inside; text-decoration: underline dotted red; margin: 1px 2px; border: 3px double blue }
#e { flex: none; overflow: scroll; flex-flow: column wrap; border-radius: 3px; font: 2em/1.5 monospace; gap: 4px; inset: 0; padding: 0 1px 2px 3px }
#f { flex: 3; overflow-x: clip; border-top: 1px solid; font-size: 10px; font: 20px Arial; list-style: none; text-decoration: none }
#g { flex: auto; flex-grow: 5; overflow: hidden; overflow-y: visible; border: 1px solid red; border-left-style: none }
</style></head><body><div id="d"><b id="d1">z</b></div><div id="e">e</div><div id="f">f</div><div id="g">g</div></body></html>
#code
function show(id, names) {
    var cs = getComputedStyle(document.getElementById(id));
    console.log(id + ' ' + names.split(' ').map(function (n) { return n + ': ' + cs.getPropertyValue(n); }).join('; '));
}
show('d', 'font-style font-weight font-size line-height font-family overflow-x overflow-y overflow flex-grow flex-shrink flex-basis flex');
show('d', 'row-gap column-gap gap top right bottom left inset border-top-left-radius border-top-right-radius border-bottom-right-radius border-bottom-left-radius border-radius');
show('d', 'list-style-type list-style-position text-decoration-line text-decoration-style text-decoration-color margin-top margin-left margin border-top-width border-left-style border-right-color');
show('d1', 'font-style font-weight font-size line-height font-family list-style-type list-style-position text-decoration-line overflow-x');
show('e', 'flex-grow flex-shrink flex-basis flex overflow-x overflow-y overflow flex-direction flex-wrap border-top-left-radius border-radius font-size line-height font-family font-style font-weight');
show('e', 'row-gap column-gap gap top left inset padding-top padding-right padding-bottom padding-left padding');
show('f', 'flex-grow flex-shrink flex-basis overflow-x overflow-y border-top-width border-top-style border-bottom-width font-size font-family line-height list-style-type text-decoration-line');
show('g', 'flex-grow flex-shrink flex-basis overflow-x overflow-y border-top-width border-left-width border-left-style border-right-style border-width');
#expect
d font-style: italic; font-weight: 700; font-size: 12px; line-height: 30px; font-family: Georgia, serif; overflow-x: hidden; overflow-y: auto; overflow: hidden auto; flex-grow: 2; flex-shrink: 1; flex-basis: 120px; flex: 2 1 120px
d row-gap: 12px; column-gap: 2px; gap: 12px 2px; top: 1px; right: 2px; bottom: 3px; left: 2px; inset: 1px 2px 3px; border-top-left-radius: 12px; border-top-right-radius: 2px; border-bottom-right-radius: 12px; border-bottom-left-radius: 2px; border-radius: 12px 2px
d list-style-type: square; list-style-position: inside; text-decoration-line: underline; text-decoration-style: dotted; text-decoration-color: rgb(255, 0, 0); margin-top: 1px; margin-left: 2px; margin: 1px 2px; border-top-width: 3px; border-left-style: double; border-right-color: rgb(0, 0, 255)
d1 font-style: italic; font-weight: 900; font-size: 12px; line-height: 30px; font-family: Georgia, serif; list-style-type: square; list-style-position: inside; text-decoration-line: none; overflow-x: visible
e flex-grow: 0; flex-shrink: 0; flex-basis: auto; flex: 0 0 auto; overflow-x: scroll; overflow-y: scroll; overflow: scroll; flex-direction: column; flex-wrap: wrap; border-top-left-radius: 3px; border-radius: 3px; font-size: 32px; line-height: 48px; font-family: monospace; font-style: normal; font-weight: 400
e row-gap: 4px; column-gap: 4px; gap: 4px; top: 0px; left: 0px; inset: 0px; padding-top: 0px; padding-right: 1px; padding-bottom: 2px; padding-left: 3px; padding: 0px 1px 2px 3px
f flex-grow: 3; flex-shrink: 1; flex-basis: 0%; overflow-x: clip; overflow-y: visible; border-top-width: 1px; border-top-style: solid; border-bottom-width: 0px; font-size: 20px; font-family: Arial; line-height: normal; list-style-type: none; text-decoration-line: none
g flex-grow: 5; flex-shrink: 1; flex-basis: auto; overflow-x: hidden; overflow-y: visible; border-top-width: 1px; border-left-width: 0px; border-left-style: none; border-right-style: solid; border-width: 1px 1px 1px 0px

#name getComputedStyle: inherit, initial and unset
#html
<!DOCTYPE html><html><head><title>t</title><style>
#a { color: rgb(1, 2, 3); margin-top: 7px; font-size: 30px; text-align: center; border-top: 2px solid; visibility: hidden; cursor: pointer }
#b { margin-top: inherit; color: initial; font-size: unset; text-align: initial; border-top-width: inherit; border-top-style: inherit }
#c { color: unset; margin-top: unset; visibility: initial; cursor: inherit; display: inherit; font-size: initial }
#d { all: unset; --gap: 12px; --name: "Ann" }
</style></head><body><div id="a"><p id="b">b<span id="b1">x</span></p><p id="c">c</p><p id="d"><i id="d1">d</i></p></div></body></html>
#code
function show(id, names) {
    var cs = getComputedStyle(document.getElementById(id));
    console.log(id + ' ' + names.split(' ').map(function (n) { return n + ': ' + cs.getPropertyValue(n); }).join('; '));
}
show('a', 'color margin-top font-size text-align border-top-width visibility cursor');
show('b', 'color margin-top font-size text-align border-top-width border-top-style visibility cursor');
show('b1', 'color margin-top font-size text-align visibility cursor');
show('c', 'color margin-top visibility cursor display font-size');
show('d', '--gap --name --missing');
show('d1', '--gap --name');
#expect
a color: rgb(1, 2, 3); margin-top: 7px; font-size: 30px; text-align: center; border-top-width: 2px; visibility: hidden; cursor: pointer
b color: rgb(0, 0, 0); margin-top: 7px; font-size: 30px; text-align: start; border-top-width: 2px; border-top-style: solid; visibility: hidden; cursor: pointer
b1 color: rgb(0, 0, 0); margin-top: 0px; font-size: 30px; text-align: start; visibility: hidden; cursor: pointer
c color: rgb(1, 2, 3); margin-top: 0px; visibility: visible; cursor: pointer; display: block; font-size: 16px
d --gap: 12px; --name: "Ann"; --missing: 
d1 --gap: 12px; --name: "Ann"
