#name disabled controls and fieldsets
#html
<body><form id="f"><fieldset id="fs" disabled><legend><input id="inlegend" name="l" value="1"></legend><input id="a" name="a" value="2"><select id="s" name="s"><option>3</option></select></fieldset><input id="b" name="b" value="4" disabled><input id="c" name="c" value="5"></form></body>
#code
var q = function (id) { return document.getElementById(id); };
console.log(q('a').disabled, q('a').matches(':disabled'), q('s').matches(':disabled'), q('inlegend').matches(':disabled'), q('b').matches(':disabled'), q('c').matches(':enabled'), q('fs').matches(':disabled'), q('a').willValidate);
console.log(new URLSearchParams(new FormData(q('f'))).toString(), q('fs').elements.length, q('fs').type, q('fs').form === q('f'));
q('fs').disabled = false;
console.log(new URLSearchParams(new FormData(q('f'))).toString());
#expect
false true true false true true true false
l=1&c=5 3 fieldset true
l=1&a=2&s=3&c=5

#name a click on a disabled control fires nothing
