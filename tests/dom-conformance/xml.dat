#name namespaces of elements and attributes
#code
var d = new DOMParser().parseFromString('<r xmlns="urn:d" xmlns:p="urn:p" p:at="1" plain="2"><p:e xmlns:q="urn:q" q:x="3"><f xmlns=""/></p:e></r>', 'application/xml');
var r = d.documentElement, e = r.firstChild, f = e.firstChild;
console.log(r.namespaceURI, r.prefix, r.localName, r.tagName, '|', e.namespaceURI, e.prefix, e.localName, e.tagName, e.nodeName, '|', f.namespaceURI, f.prefix, f.tagName);
console.log(r.attributes.length);
for (var i = 0; i < r.attributes.length; i++) {
    var a = r.attributes[i];
    console.log([a.name, a.localName, a.prefix, a.namespaceURI, a.value, a.nodeName].join(' | '));
}
console.log(r.getAttributeNS('urn:p', 'at'), r.getAttribute('p:at'), r.getAttributeNS(null, 'plain'), r.getAttributeNS('urn:p', 'plain'), r.getAttributeNS(null, 'at'), r.getAttribute('at'));
console.log(r.hasAttributeNS('http://www.w3.org/2000/xmlns/', 'p'), r.hasAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns'), r.hasAttributeNS(null, 'xmlns'), e.getAttributeNS('urn:q', 'x'), e.hasAttribute('q:x'), e.hasAttribute('x'));
console.log(new XMLSerializer().serializeToString(d));
#expect
urn:d null r r | urn:p p e p:e p:e | null null f
