#name what may be done in which state
#code
function attempt(name, fn) { try { var v = fn(); console.log(name, v === undefined ? 'ok' : v); } catch (e) { console.log(name, e.name); } }
function opened(async) { var x = new XMLHttpRequest(); x.open('GET', 'data:text/xml,<a/>', async !== false); return x; }
function done() { var x = opened(false); x.send(); return x; }
attempt('send before open', function () { new XMLHttpRequest().send(); });
attempt('send twice', function () { var x = opened(); x.send(); x.send(); });
attempt('setRequestHeader before open', function () { new XMLHttpRequest().setRequestHeader('a', 'b'); });
attempt('setRequestHeader after send', function () { var x = opened(); x.send(); x.setRequestHeader('a', 'b'); });
attempt('setRequestHeader', function () { opened().setRequestHeader('X-A', ' b '); });
attempt('a header name with a space', function () { opened().setRequestHeader('a b', 'c'); });
attempt('an empty header name', function () { opened().setRequestHeader('', 'c'); });
attempt('a header value with a line feed', function () { opened().setRequestHeader('a', 'c\nd'); });
attempt('a header value that ends in a line feed', function () { opened().setRequestHeader('a', 'c\n'); });
attempt('one argument', function () { opened().setRequestHeader('a'); });
attempt('responseType when done', function () { done().responseType = 'text'; });
attempt('an unknown responseType when done', function () { var x = done(); x.responseType = 'rubbish'; return x.responseType === ''; });
attempt('overrideMimeType when done', function () { done().overrideMimeType('text/plain'); });
attempt('overrideMimeType before open', function () { new XMLHttpRequest().overrideMimeType('text/plain'); });
attempt('responseType on a synchronous request', function () { opened(false).responseType = 'document'; });
attempt('timeout on a synchronous request', function () { opened(false).timeout = 5; });
attempt('synchronous after a responseType', function () { var x = new XMLHttpRequest(); x.responseType = 'text'; x.open('GET', 'data:,', false); });
attempt('synchronous after a timeout', function () { var x = new XMLHttpRequest(); x.timeout = 5; x.open('GET', 'data:,', false); });
attempt('timeout', function () { var x = new XMLHttpRequest(); x.timeout = 250; return x.timeout; });
attempt('withCredentials', function () { var x = new XMLHttpRequest(); x.withCredentials = true; return x.withCredentials; });
attempt('withCredentials after send', function () { var x = opened(); x.send(); x.withCredentials = true; });
attempt('withCredentials when done', function () { done().withCredentials = true; });
attempt('upload', function () { var x = new XMLHttpRequest(); return [x.upload === x.upload, x.upload instanceof XMLHttpRequestUpload, x.upload instanceof XMLHttpRequestEventTarget, x instanceof EventTarget].join(); });
#expect
send before open InvalidStateError
send twice InvalidStateError
setRequestHeader before open InvalidStateError
setRequestHeader after send InvalidStateError
setRequestHeader ok
a header name with a space SyntaxError
an empty header name SyntaxError
a header value with a line feed SyntaxError
a header value that ends in a line feed ok
one argument TypeError
responseType when done InvalidStateError
an unknown responseType when done true
overrideMimeType when done InvalidStateError
overrideMimeType before open ok
responseType on a synchronous request InvalidAccessError
timeout on a synchronous request InvalidAccessError
synchronous after a responseType InvalidAccessError
synchronous after a timeout InvalidAccessError
timeout 250
withCredentials true
withCredentials after send InvalidStateError
withCredentials when done InvalidStateError
upload true,true,true,true

#name a synchronous request
#code
var x = new XMLHttpRequest(), seen = [];
x.onreadystatechange = function () { seen.push('state ' + x.readyState); };
x.onload = function () { seen.push('load'); };
x.onloadend = function () { seen.push('loadend'); };
x.onloadstart = function () { seen.push('loadstart'); };
x.open('GET', 'data:text/xml,<a><b/></a>', false);
x.send();
console.log(seen.filter(function (s) { return s !== 'loadstart'; }).join(', '));
console.log(x.readyState, x.status, x.statusText, x.responseText, x.responseXML.documentElement.firstChild.nodeName, x.responseXML === x.responseXML);
var bad = new XMLHttpRequest(), events = [];
bad.onreadystatechange = function () { events.push(bad.readyState); };
bad.onerror = function () { events.push('error'); };
bad.open('GET', 'data:text/xml;base64,@@@', false);
try { bad.send(); console.log('sent'); } catch (e) { console.log(e.name, e instanceof DOMException, e.code); }
console.log(events.join(), bad.readyState, bad.status, JSON.stringify(bad.responseText), bad.responseXML);
var post = new XMLHttpRequest();
post.open('POST', 'data:text/plain,p', false);
post.send('body');
console.log(post.status, post.responseText);
#expect
state 1, state 4, load, loadend
4 200 OK <a><b/></a> b true
NetworkError true 19
1 4 0 "" null
200 p

#name a request that cannot be answered fails
#code
var x = new XMLHttpRequest(), seen = [];
['readystatechange', 'loadstart', 'progress', 'load', 'error', 'abort', 'loadend'].forEach(function (type) {
    x.addEventListener(type, function (e) { seen.push(type === 'readystatechange' ? 'state ' + x.readyState : type + ' ' + e.loaded + ' ' + e.total); });
});
x.addEventListener('loadend', function () {
    console.log(seen.join(', '));
    console.log(x.readyState, x.status, JSON.stringify(x.statusText), JSON.stringify(x.responseText), x.responseXML, x.response === '', x.getResponseHeader('content-type'), JSON.stringify(x.getAllResponseHeaders()), JSON.stringify(x.responseURL));
});
x.open('GET', 'data:text/xml;base64,@@@');
x.send();
#expect
state 1, loadstart 0 0, state 4, error 0 0, loadend 0 0
4 0 "" "" null true null "" ""

#name abort()
#code
function watch(x, seen) {
    ['readystatechange', 'loadstart', 'progress', 'load', 'error', 'abort', 'loadend'].forEach(function (type) {
        x.addEventListener(type, function () { seen.push(type === 'readystatechange' ? 'state ' + x.readyState : type); });
    });
}
var a = new XMLHttpRequest(), sa = []; watch(a, sa);
a.abort();
console.log('unsent:', sa.join(', '), a.readyState);
a.open('GET', 'data:text/xml,<a/>'); sa.length = 0;
a.abort();
console.log('opened:', sa.join(', '), a.readyState);
a.send(); sa.length = 0;
a.abort();
console.log('sent:', sa.join(', '), a.readyState, a.status, JSON.stringify(a.responseText));
var d = new XMLHttpRequest(), sd = [];
d.open('GET', 'data:text/xml,<a/>', false); d.send(); watch(d, sd);
d.abort();
console.log('done:', sd.join(', '), d.readyState, d.status, JSON.stringify(d.responseText), d.responseXML);
var h = new XMLHttpRequest(), sh = []; watch(h, sh);
h.addEventListener('readystatechange', function () { if (h.readyState === 2) h.abort(); });
h.addEventListener('loadend', function () { Promise.resolve().then(function () { console.log('at headers:', sh.join(', '), h.readyState, h.status); }); });
h.open('GET', 'data:text/xml,<a/>');
h.send();
#expect
unsent:  0
opened:  1
sent: state 4, abort, loadend 0 0 ""
done:  0 0 "" null
at headers: state 1, loadstart, state 2, state 4, abort, loadend 0 0

#name open() again starts over
#code
var x = new XMLHttpRequest();
x.open('GET', 'data:text/xml,<a/>', false);
x.send();
var first = x.responseXML;
console.log(x.status, x.responseText, first.documentElement.nodeName);
x.open('GET', 'data:text/xml,<b/>', false);
console.log(x.readyState, x.status, JSON.stringify(x.responseText), x.responseXML, JSON.stringify(x.responseURL), x.getResponseHeader('content-type'));
x.send();
console.log(x.status, x.responseText, x.responseXML.documentElement.nodeName, x.responseXML !== first, first.documentElement.nodeName);
var y = new XMLHttpRequest(), seen = [];
y.onload = function () { seen.push('load ' + y.responseText); };
y.onloadend = function () { seen.push('loadend'); console.log(seen.join(', ')); };
y.open('GET', 'data:text/plain,first');
y.send();
y.open('GET', 'data:text/plain,second');
y.send();
#expect
200 <a/> a
1 0 "" null "" null
200 <b/> b true a
load second, loadend

#name the events and their handlers
#code
var x = new XMLHttpRequest();
x.addEventListener('load', function (e) {
    console.log(e.type, e.target === x, e.currentTarget === x, e instanceof ProgressEvent, e.bubbles, e.cancelable, e.isTrusted, e.loaded, e.total, e.lengthComputable);
});
x.onload = function (e) { console.log('handler', this === x, e.type); };
x.onreadystatechange = function (e) { if (x.readyState === 4) console.log(e.type, e instanceof ProgressEvent, e instanceof Event, e.bubbles, e.cancelable, this === x); };
console.log(typeof x.onload, x.onerror, x.onabort, x.ontimeout, x.onloadstart, x.onprogress, x.onloadend, 'onload' in XMLHttpRequestEventTarget.prototype, 'onreadystatechange' in XMLHttpRequestEventTarget.prototype);
x.open('GET', 'data:text/plain,abc');
x.send();
#expect
function null null null null null null true false
readystatechange false true false false true
load true true true false false true 3 0 false
handler true load
