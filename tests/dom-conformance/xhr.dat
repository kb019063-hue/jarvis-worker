#name which types give a document
#code
var cases = [
    'data:application/xml,<a/>', 'data:text/xml,<a/>', 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg"><g/></svg>',
    'data:application/rss+xml,<rss/>', 'data:application/vnd.example+xml;charset=utf-8,<a/>', 'data:TEXT/XML,<a/>',
    'data:text/plain,<a/>', 'data:application/json,<a/>', 'data:,<a/>', 'data:text/xml-external-parsed-entity,<a/>',
    'data:application/xml,<a><b></a>', 'data:application/xml,', 'data:application/xml,<a/><b/>', 'data:text/html,<p>x</p>',
];
var at = 0;
(function next() {
    if (at === cases.length) return;
    var x = new XMLHttpRequest(), url = cases[at++];
    x.onloadend = function () {
        var d = x.responseXML;
        console.log(x.status, x.getResponseHeader('content-type'), d ? d.documentElement.nodeName + ' ' + d.documentElement.constructor.name : String(d), JSON.stringify(x.responseText));
        next();
    };
    x.open('GET', url);
    x.send();
})();
#expect
200 application/xml a Element "<a/>"
200 text/xml a Element "<a/>"
200 image/svg+xml svg SVGSVGElement "<svg xmlns=\"http://www.w3.org/2000/svg\"><g/></svg>"
200 application/rss+xml rss Element "<rss/>"
200 application/vnd.example+xml;charset=utf-8 a Element "<a/>"
200 text/xml a Element "<a/>"
200 text/plain null "<a/>"
200 application/json null "<a/>"
200 text/plain;charset=US-ASCII null "<a/>"
200 text/xml-external-parsed-entity null "<a/>"
200 application/xml null "<a><b></a>"
200 application/xml null ""
200 application/xml null "<a/><b/>"
200 text/html null "<p>x</p>"

