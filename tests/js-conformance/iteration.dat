var bare = { i: 0, next: function () { return this.i < 2 ? { value: this.i++, done: false } : { done: true }; } };
console.log(t(function () { return [...bare]; }), t(function () { var o = []; for (var x of bare) o.push(x); return o; }), t(function () { return new Set(bare).size; }), t(function () { return Array.from(bare).length; }));
