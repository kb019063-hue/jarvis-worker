#name for...of asks an array for its own iterator
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
var out = []; for (var x of a) out.push(x);
console.log(out.join());
#expect
9,8

#name spread in an array literal asks the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
console.log([...a].join(), [0, ...a, 0].join());
#expect
9,8 0,9,8,0

#name spread in a call and in new asks the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
function f() { return Array.prototype.slice.call(arguments).join(); }
function C() { this.args = Array.prototype.slice.call(arguments).join(); }
console.log(f(...a), f(0, ...a), new C(...a).args, Math.max(...a));
#expect
9,8 0,9,8 9,8 9

#name Array.from asks the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
console.log(Array.from(a).join(), Array.from(a, function (v, i) { return v * 10 + i; }).join());
#expect
9,8 90,81

#name Set and Map ask the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
var p = [[1, 2]]; p[Symbol.iterator] = function* () { yield ['k', 'v']; };
console.log([...new Set(a)].join(), [...new Map(p)].join(), new Map(p).get('k'));
#expect
9,8 k,v v

#name WeakSet and WeakMap ask the array
#code
var k1 = {}, k2 = {};
var a = [k1]; a[Symbol.iterator] = function* () { yield k2; };
var p = [[k1, 1]]; p[Symbol.iterator] = function* () { yield [k2, 2]; };
var ws = new WeakSet(a), wm = new WeakMap(p);
console.log(ws.has(k1), ws.has(k2), wm.has(k1), wm.get(k2));
#expect
false true false 2

#name Promise.all, allSettled, race and any ask the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
Promise.all(a).then(function (v) { console.log('all', v.join()); });
Promise.allSettled(a).then(function (v) { console.log('allSettled', v.map(function (r) { return r.value; }).join()); });
Promise.race(a).then(function (v) { console.log('race', v); });
Promise.any(a).then(function (v) { console.log('any', v); });
#expect
all 9,8
allSettled 9,8
race 9
any 9

#name Object.fromEntries asks the array
#code
var p = [['a', 1]]; p[Symbol.iterator] = function* () { yield ['z', 26]; };
console.log(JSON.stringify(Object.fromEntries(p)));
#expect
{"z":26}

#name yield* asks the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
function* g() { yield* a; }
console.log([...g()].join(), Array.from(g()).join());
#expect
9,8 9,8

#name for await asks the array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
(async function () { var out = []; for await (var x of a) out.push(x); console.log(out.join()); })();
#expect
9,8

#name the iterator method gets the array as this, and no arguments
#code
var a = [1, 2]; var seen;
a[Symbol.iterator] = function () { seen = [this === a, arguments.length]; return [7][Symbol.iterator](); };
console.log([...a].join(), seen.join());
#expect
7 true,0

#name an iterator method that is a plain function returning a hand-written iterator
#code
var a = [1, 2];
a[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < 3 ? { value: i++, done: false } : { value: undefined, done: true }; } }; };
var out = []; for (var x of a) out.push(x);
console.log(out.join(), [...a].join(), Array.from(a).join(), new Set(a).size);
#expect
0,1,2 0,1,2 0,1,2 3

#name Promise.all over an array that hands out another array's iterator
#code
var a = [1]; a[Symbol.iterator] = function () { return [9][Symbol.iterator](); };
Promise.all(a).then(function (v) { console.log(JSON.stringify(v)); });
#expect
[9]

#name an iterator replaced on Array.prototype is the one every array has
#code
var original = Array.prototype[Symbol.iterator];
Array.prototype[Symbol.iterator] = function* () { yield 'p'; yield this.length; };
var s = [...[1, 2, 3]]; var out = []; for (var x of [5]) out.push(x);
var fromd = Array.from([1, 2]); var set = new Set([4, 4, 4]);
Array.prototype[Symbol.iterator] = original;
console.log(s.join(), out.join(), fromd.join(), [...set].join(), [...[1, 2]].join());
#expect
p,3 p,1 p,2 p,3 1,2

#name an iterator deleted from Array.prototype: an array is not iterable
#code
var original = Array.prototype[Symbol.iterator];
delete Array.prototype[Symbol.iterator];
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [];
r.push(t(function () { return [...[1, 2]]; }));
r.push(t(function () { var o = []; for (var x of [1]) o.push(x); return o; }));
r.push(t(function () { return new Set([1]).size; }));
r.push(t(function () { return new Map([[1, 2]]).size; }));
r.push(t(function () { function f() { return arguments.length; } return f(...[1, 2]); }));
Array.prototype[Symbol.iterator] = original;
console.log(r.join(' | '), [...[1, 2]].join());
#expect
TypeError | TypeError | TypeError | TypeError | TypeError 1,2

#name an iterator on Array.prototype that is not a function: TypeError
#code
var original = Array.prototype[Symbol.iterator];
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [];
[5, 'str', {}, null, undefined, true].forEach(function (v) {
  Array.prototype[Symbol.iterator] = v;
  r.push(t(function () { return [...[1, 2]]; }));
});
Array.prototype[Symbol.iterator] = original;
console.log(r.join(' | '));
#expect
TypeError | TypeError | TypeError | TypeError | TypeError | TypeError

#name a getter for the iterator on an array is read once for each iteration
#code
var a = [1, 2]; var reads = 0;
Object.defineProperty(a, Symbol.iterator, { get: function () { reads++; return Array.prototype[Symbol.iterator]; } });
var s = [...a]; var r1 = reads; for (var x of a) {} var r2 = reads; Array.from(a); var r3 = reads; new Set(a); var r4 = reads;
console.log(s.join(), r1, r2, r3, r4);
#expect
1,2 1 2 3 4

#name a getter for the iterator on Array.prototype gets the array as receiver
#code
var original = Array.prototype[Symbol.iterator]; var log = [];
var a = [1, 2];
Object.defineProperty(Array.prototype, Symbol.iterator, { configurable: true, get: function () { log.push(this === a); return original; } });
var s = [...a];
Object.defineProperty(Array.prototype, Symbol.iterator, { configurable: true, writable: true, enumerable: false, value: original });
console.log(s.join(), log.join());
#expect
1,2 true

#name a subclass of Array with an iterator of its own
#code
class L extends Array { *[Symbol.iterator]() { yield 'x'; yield this.length; } }
var l = new L(3);
var out = []; for (var x of l) out.push(x);
console.log([...l].join(), out.join(), Array.from(l).join(), new Set(l).size);
#expect
x,3 x,3 x,3 2

#name a subclass of Array without one iterates its elements
#code
class L extends Array {}
var l = L.from([1, 2, 3]); l.push(4);
var out = []; for (var x of l) out.push(x);
console.log([...l].join(), out.join(), new Set(l).size);
#expect
1,2,3,4 1,2,3,4 4

#name a subclass reaches Array's iterator through super
#code
class L extends Array { [Symbol.iterator]() { var it = super[Symbol.iterator](); return { next: function () { var s = it.next(); if (!s.done) s.value = s.value * 2; return s; } }; } }
var l = new L(); l.push(1, 2, 3);
console.log([...l].join());
#expect
2,4,6

#name the built-in iterator assigned back, and keys, entries and a bound one in its place
#code
var a = [1, 2]; a[Symbol.iterator] = Array.prototype[Symbol.iterator];
var b = [3, 4]; b[Symbol.iterator] = Array.prototype.values;
var c = [5, 6]; c[Symbol.iterator] = Array.prototype.keys;
var d = [7, 8]; d[Symbol.iterator] = Array.prototype.entries;
var e = [9]; e[Symbol.iterator] = [][Symbol.iterator].bind([0, 0]);
console.log([...a].join(), [...b].join(), [...c].join(), JSON.stringify([...d]), [...e].join());
#expect
1,2 3,4 0,1 [[0,7],[1,8]] 0,0

#name an iterator given to the array while it is being iterated
#code
var a = [1, 2, 3]; var out = [];
for (var x of a) { out.push(x); a[Symbol.iterator] = function* () { yield 'late'; }; }
out.push([...a].join());
console.log(out.join());
#expect
1,2,3,late

#name an iterator replaced on String.prototype is the one every string has
#code
var original = String.prototype[Symbol.iterator];
String.prototype[Symbol.iterator] = function* () { yield 'z'; yield this.length; };
var s = [...'ab']; var out = []; for (var x of 'q') out.push(x);
var fromd = Array.from('abc'); var set = new Set('aab'); var [d1, d2] = 'xy';
String.prototype[Symbol.iterator] = original;
console.log(s.join(), out.join(), fromd.join(), [...set].join(), d1, d2, [...'ab'].join());
