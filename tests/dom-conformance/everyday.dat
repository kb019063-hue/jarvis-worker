#name events/on: direct and delegated
#code
function addEventListener(el, eventName, eventHandler, selector) {
  if (selector) {
    const wrappedHandler = (e) => {
      if (!e.target) return;
      const el = e.target.closest(selector);
      if (el) {
        eventHandler.call(el, e);
      }
    };
    el.addEventListener(eventName, wrappedHandler);
    return wrappedHandler;
  } else {
    const wrappedHandler = (e) => {
      eventHandler.call(el, e);
    };
    el.addEventListener(eventName, wrappedHandler);
    return wrappedHandler;
  }
}
var out = [];
var main = document.getElementById('main');
addEventListener(main, 'click', function (e) { out.push('direct:' + this.id + ':' + e.target.tagName); });
addEventListener(main, 'click', function (e) { out.push('delegated:' + this.tagName); }, 'li');
document.querySelector('.first').click();
document.querySelector('b').click();
console.log(out.join(' '));
#expect
direct:main:LI delegated:LI direct:main:B

#name events/ready
#code
function ready(fn) {
  if (document.readyState !== 'loading') {
    fn();
  } else {
    document.addEventListener('DOMContentLoaded', fn);
  }
}
ready(function () { console.log('ready', document.readyState !== 'loading', document.body !== null); });
#expect
ready true true

#name events/trigger_custom: CustomEvent
#code
var el = document.querySelector('.title');
el.addEventListener('my-event', (e) => { console.log(e.type, e.detail.some, e.bubbles, e instanceof CustomEvent, e.target === el); });
const event = new CustomEvent('my-event', {detail: {some: 'data'}});
console.log(el.dispatchEvent(event));
#expect
my-event data false true true
true

#name events/trigger_native
#code
function trigger(el, eventType) {
  if (typeof eventType === 'string' && typeof el[eventType] === 'function') {
    el[eventType]();
  } else {
    const event =
      typeof eventType === 'string'
        ? new Event(eventType, {bubbles: true})
        : eventType;
    el.dispatchEvent(event);
  }
}
var out = [];
var el = document.querySelector('input[name=user]');
el.addEventListener('focus', (e) => out.push('focus:' + (document.activeElement === el)));
el.addEventListener('change', (e) => out.push('change:' + e.bubbles));
el.addEventListener('pointerover', (e) => out.push(e.type + ':' + (e instanceof PointerEvent)));
trigger(el, 'focus');
trigger(el, 'change');
trigger(el, new PointerEvent('pointerover'));
console.log(out.join(' '));
#expect
focus:true change:true pointerover:true

#name utils/parse_html: createHTMLDocument
#code
function parseHTML(str) {
  const tmp = document.implementation.createHTMLDocument('');
  tmp.body.innerHTML = str;
  return [...tmp.body.childNodes];
}
var nodes = parseHTML('<p>a</p>text<span>b</span>');
console.log(nodes.length, nodes[0].tagName, nodes[1].nodeType, nodes[2].ownerDocument !== document, nodes[0].ownerDocument.defaultView);
#expect
3 P 3 true null

