#name getComputedStyle: what HTML elements are by default
#html
<!DOCTYPE html><html><head><title>t</title></head><body><h1 id="h1">x</h1><h2 id="h2">x</h2><h3 id="h3">x</h3><h4 id="h4">x</h4><h5 id="h5">x</h5><h6 id="h6">x</h6><p id="p"><b id="b">b</b><strong id="st"><b id="bb">x</b></strong><i id="i">i</i><em id="em">e</em><a id="a" href="#x">a</a><a id="plain">a</a><small id="sm">s</small><sub id="sub">s</sub><code id="c">c</code><mark id="mk">m</mark><u id="un">u</u><s id="sk">s</s></p><ul id="ul"><li id="li">x</li><ul id="ul2"><li id="li2">y</li></ul></ul><ol id="ol"><li id="oli">x</li></ol><blockquote id="q">q</blockquote><table><tr id="tr"><th id="th">h</th><td id="td">d</td></tr></table><pre id="pre">x</pre><hr id="hr"><fieldset id="fs"><legend id="lg">l</legend></fieldset><dl><dd id="dd">d</dd></dl><address id="ad">a</address></body></html>
#code
function show(id, names) {
    var cs = getComputedStyle(document.getElementById(id));
    console.log(id + ' ' + names.split(' ').map(function (n) { return n + ': ' + cs.getPropertyValue(n); }).join('; '));
}
show('h1', 'font-size font-weight margin-top margin-bottom margin-left');
