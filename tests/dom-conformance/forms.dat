#name textarea: value, defaultValue and the text inside
#code
var n = document.getElementById('note');
console.log(JSON.stringify(n.value), JSON.stringify(n.defaultValue), n.textLength, n.type, n.textContent === n.defaultValue);
n.value = 'typed';
console.log(n.value, JSON.stringify(n.defaultValue), n.textContent.length, n.innerHTML.length);
n.textContent = 'new default';
console.log(n.value, n.defaultValue);
