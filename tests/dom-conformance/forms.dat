#name the form attribute points across the tree
#code
var o = document.getElementById('outside'), f = document.getElementById('f');
console.log(o.form === f, new FormData(f).get('far'));
o.setAttribute('form', 'nosuch');
console.log(o.form, new FormData(f).has('far'));
o.removeAttribute('form');
console.log(o.form);
#expect
true away
null false
null

#name file inputs
#code
var u = document.getElementById('up');
console.log(u.type, JSON.stringify(u.value), u.files.length, u.files instanceof FileList, u.multiple, JSON.stringify(u.accept));
try { u.value = 'c:\\path'; console.log('no error'); } catch (e) { console.log(e.name); }
u.value = '';
console.log(JSON.stringify(u.value));
#expect
file "" 0 true false ""
InvalidStateError
""

#name hidden inputs and inputs of other types in FormData
#code
var f = document.createElement('form');
f.innerHTML = '<input type="hidden" name="h" value="1"><input type="submit" name="s" value="2"><input type="image" name="i"><input type="button" name="b" value="3"><input type="reset" name="r" value="4"><input name="" value="noname"><input value="noname2"><input type="checkbox" name="c"><input type="radio" name="d" value="5"><button name="e" value="6">x</button><textarea name="t"></textarea><select name="o"></select><select name="p"><option></option></select>';
console.log(new URLSearchParams(new FormData(f)).toString());
#expect
h=1&t=&p=

#name output, datalist and meter exist as form-related elements
#code
var o = document.createElement('output');
o.value = 'result';
console.log(o.value, o.textContent, o.defaultValue, o.type, o instanceof HTMLOutputElement);
var d = document.createElement('datalist');
d.innerHTML = '<option value="a"><option value="b">';
console.log(d.options.length, d.options[1].value);
#expect
result result  output true
2 b

#name autofocus, placeholder, readOnly, required as properties
#code
var i = document.createElement('input');
i.autofocus = true; i.placeholder = 'hint'; i.readOnly = true; i.required = true; i.autocomplete = 'off'; i.inputMode = 'numeric';
console.log(i.outerHTML);
console.log(i.willValidate, i.matches(':read-only'), i.matches(':required'), i.matches(':placeholder-shown'));
#expect
<input autofocus="" placeholder="hint" readonly="" required="" autocomplete="off" inputmode="numeric">
false true true true

#name programmatic focus moves through controls and fires events in order
#code
var u = document.getElementById('user'), p = document.getElementById('pw');
var log = [];
[u, p].forEach(function (el) { ['focus', 'blur', 'focusin', 'focusout'].forEach(function (t) { el.addEventListener(t, function () { log.push(t + '@' + el.id); }); }); });
u.focus(); p.focus(); p.blur();
console.log(log.join(' '));
#expect
focus@user focusin@user blur@user focusout@user focus@pw focusin@pw blur@pw focusout@pw

#name a select's change event comes from clicking an option? no: from setting state it does not
#code
var c = document.getElementById('color'), n = 0;
c.addEventListener('change', function () { n++; });
c.value = 'r'; c.selectedIndex = 2; c.options[0].selected = true;
console.log(n, c.value);
c.dispatchEvent(new Event('change', {bubbles: true}));
console.log(n);
#expect
0 r
1

#name a form inside a detached tree works the same
#code
var f = document.createElement('form');
f.innerHTML = '<input name="a" value="1"><input type="checkbox" name="b" checked><button>go</button>';
var n = 0;
f.addEventListener('submit', function (e) { n++; e.preventDefault(); });
console.log(f.elements.length, f.elements.a.value, new URLSearchParams(new FormData(f)).toString());
f.querySelector('button').click();
console.log(n);
#expect
3 1 a=1&b=on
0

#name Enter-like implicit submission is not simulated; dispatching keydown does nothing by itself
#code
var f = document.getElementById('f'), n = 0;
f.addEventListener('submit', function (e) { n++; e.preventDefault(); });
document.getElementById('user').dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter', bubbles: true}));
document.getElementById('user').dispatchEvent(new KeyboardEvent('keypress', {key: 'Enter', bubbles: true}));
console.log(n);
#expect
0
