#name responseType decides what response is
#code
var cases = [['', 'data:text/xml,<a/>'], ['text', 'data:text/xml,<a/>'], ['document', 'data:text/xml,<a/>'], ['document', 'data:text/plain,<a/>'],
             ['document', 'data:text/xml,<a>'], ['json', 'data:application/json,{"a":[1,null]}'], ['json', 'data:text/plain,[2]'],
             ['json', 'data:application/json,{bad'], ['json', 'data:application/json,null'], ['blob', 'data:text/xml,<a/>']];
var at = 0;
(function next() {
    if (at === cases.length) return;
    var c = cases[at++], x = new XMLHttpRequest();
    x.responseType = c[0];
    x.onloadend = function () {
        var text, xml, r = x.response, shown;
        try { text = JSON.stringify(x.responseText); } catch (e) { text = e.name; }
        try { xml = x.responseXML ? 'document' : String(x.responseXML); } catch (e) { xml = e.name; }
        if (r && r.nodeType === 9) shown = 'document ' + r.documentElement.nodeName + ' ' + (r === x.response) + ' ' + (r === x.responseXML);
        else if (r && typeof r.size === 'number' && typeof r.slice === 'function') shown = 'blob ' + r.size + ' ' + r.type + ' ' + (r === x.response);
        else shown = typeof r + ' ' + JSON.stringify(r) + (r && typeof r === 'object' ? ' ' + (r === x.response) : '');
        console.log(JSON.stringify(x.responseType), '|', text, '|', xml, '|', shown);
        next();
    };
    x.open('GET', c[1]);
    x.send();
})();
var y = new XMLHttpRequest();
['arraybuffer', 'blob', 'document', 'json', 'text', '', 'rubbish', 'TEXT', null].forEach(function (type) { y.responseType = type; console.log(JSON.stringify(type), '->', JSON.stringify(y.responseType)); });
