#name super() twice: the parent runs again, then it is a ReferenceError
#code
var runs = 0;
class A { constructor() { runs++; } }
class B extends A {
  constructor() {
    super();
    try { super(); this.second = 'no error'; } catch (e) { this.second = e.name; }
  }
}
var b = new B();
console.log(runs, b.second, b instanceof B);
#expect
2 ReferenceError true

#name a derived constructor may return an object or nothing, not a primitive
#code
class A {}
function attempt(value) {
  class B extends A { constructor() { super(); return value; } }
  try { var b = new B(); return b instanceof B ? 'instance' : typeof b; } catch (e) { return e.name; }
}
var obj = {}, fn = function () {};
console.log(attempt(undefined), attempt(null), attempt(1), attempt('s'), attempt(false), attempt(Symbol('x')), attempt(obj), attempt(fn), attempt([]));
class Plain { constructor() { return 1; } }
function Old() { return 'text'; }
console.log(new Plain() instanceof Plain, new Old() instanceof Old);
#expect
instance TypeError TypeError TypeError TypeError TypeError object function object
true true

#name a derived constructor that returns without calling super()
#code
class A { constructor() { this.a = 1; } }
function attempt(Class) { try { var o = new Class(); return o instanceof A ? 'instance' : JSON.stringify(o); } catch (e) { return e.name; } }
class Never extends A { constructor() {} }
class Sometimes extends A { constructor(yes) { if (yes) super(); } }
class Other extends A { constructor() { return {other: true}; } }
class Caught extends A { constructor() { try { throw 1; } catch (e) {} } }
class ViaReflect extends A { constructor() {} }
var r = [attempt(Never), attempt(Other), attempt(Caught)];
try { new Sometimes(false); r.push('made'); } catch (e) { r.push(e.name); }
r.push(new Sometimes(true).a);
try { Reflect.construct(ViaReflect, []); r.push('made'); } catch (e) { r.push(e.name); }
class Top extends Never { constructor() { super(); } }
r.push(attempt(Top));
console.log(r.join(' '));
#expect
ReferenceError {"other":true} ReferenceError ReferenceError 1 ReferenceError ReferenceError

#name super() that throws leaves this unbound
#code
class Fails { constructor() { throw new RangeError('no'); } }
class Swallows extends Fails { constructor() { try { super(); } catch (e) { } } }
class Recovers extends Fails { constructor() { try { super(); } catch (e) { return {recovered: e.name}; } } }
var tries = 0;
class Flaky { constructor() { if (++tries < 2) throw new Error('first time'); this.ok = true; } }
class Retries extends Flaky { constructor() { try { super(); } catch (e) { super(); } this.after = tries; } }
var r = [];
try { new Swallows(); r.push('made'); } catch (e) { r.push(e.name); }
r.push(new Recovers().recovered);
var x = new Retries();
r.push(x.ok, x.after, x instanceof Retries);
console.log(r.join(' '));
#expect
ReferenceError RangeError true 2 true

#name a class that extends null
#code
var r = [];
function attempt(label, fn) { try { r.push(label + ':' + fn()); } catch (e) { r.push(label + ':' + e.name); } }
attempt('default', function () { class N extends null {} new N(); return 'made'; });
attempt('empty', function () { class N extends null { constructor() {} } new N(); return 'made'; });
attempt('returns', function () { class N extends null { constructor() { return Object.create(N.prototype); } hi() { return 'hi'; } } var n = new N(); return [n.hi(), Object.getPrototypeOf(N.prototype) === null, n instanceof N]; });
attempt('new.target', function () { class N extends null { constructor() { return Object.create(new.target.prototype); } } class M extends N { m() { return 'm'; } } return new M().m(); });
console.log(r.join(' '));
#expect
default:TypeError empty:ReferenceError returns:hi,true,true new.target:m

#name super() in an arrow function binds this of the constructor
#code
class A { constructor(v) { this.a = v; } }
class B extends A {
  constructor() {
    var init = (v) => super(v);
    var result = init(5);
    this.same = result === this;
    this.b = 2;
  }
}
var later;
class C extends A { constructor() { later = () => super(9); return {early: true}; } }
var b = new B(), c = new C(), r = [b.a, b.b, b.same, b instanceof B, c.early];
try { var made = later(); r.push(made.a, made instanceof C); } catch (e) { r.push(e.name); }
try { later(); r.push('twice'); } catch (e) { r.push(e.name); }
console.log(r.join(' '));
#expect
5 2 true true true 9 true ReferenceError

#name the parent is whatever the class's prototype is when super() runs, and new.target stays
#code
var seen = [];
class A { constructor() { seen.push('A:' + new.target.name); } }
class Z { constructor() { seen.push('Z:' + new.target.name); this.z = true; } }
class B extends A { constructor() { super(); seen.push('B:' + new.target.name); } }
class C extends B {}
new C();
Object.setPrototypeOf(B, Z);
var c = new C();
console.log(seen.join(' '), c.z, c instanceof A, c instanceof C);
#expect
A:C B:C Z:C B:C true true true

#name instances made with a named new.target are collected
#code
var gc = globalThis.gc || function(){ return {}; }; function churn(){ var junk = []; for (var i = 0; i < 400; i++) junk.push({i: i, s: "x" + i}); return junk.length; }

function Parent() { this.handler = () => new.target; }
function Target() {}
class Child extends Parent { constructor() { super(); this.self = () => this; this.nt = new.target; } }
class Returns extends (function () { return {made: 1}; }) { field = [1, 2, 3]; }
var keep = new Child(), ok = keep.handler() === Child && keep.nt === Child && Reflect.construct(Parent, [], Target).handler() === Target;
gc();
var before = gc().alive_cells;
for (var i = 0; i < 2000; i++) { new Child(); Reflect.construct(Parent, [], Target); Reflect.construct(Child, [], Target); new Returns(); new (Parent.bind(null))(); }
gc(); churn();
var after = gc().alive_cells;
console.log(ok, !(after - before > 100), keep.handler() === Child);
#expect
true true true

#name this cannot be used before super() has run
#code
class A { constructor() { this.a = 1; } }
var r = [];
class B extends A { constructor() { try { this.x = 1; r.push('wrote this'); } catch (e) { r.push(e.name); } super(); r.push(this.a); } }
new B();
class C extends A { constructor() { var read = () => this; try { read(); r.push('read this'); } catch (e) { r.push(e.name); } super(); r.push(read() === this); } }
new C();
class D extends A { constructor() { try { super.toString(); r.push('used super.x'); } catch (e) { r.push(e.name); } super(); } }
new D();
class E extends A { constructor() { try { return this; } catch (e) { r.push(e.name); } super(); } }
r.push(new E().a);
console.log(r.join(' '));
#expect
ReferenceError 1 ReferenceError true ReferenceError ReferenceError 1

#name new.target and super() inside eval
#code
function F() { this.direct = eval('new.target') === F; this.arrow = (() => eval('new.target'))() === F; }
function G() {}
class A { constructor() { this.a = 1; } }
class B extends A { constructor() { eval('super()'); this.b = this.a + 1; } }
var f = new F(), g = Reflect.construct(F, [], G);
console.log(f.direct, f.arrow, g.direct, eval('typeof F'), new B().b, (function () { return eval('new.target'); })() === undefined);
#expect
true true false function 2 true
