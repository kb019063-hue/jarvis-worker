#name the names of attributes are case-sensitive in XML
#code
var s = new XMLSerializer();
var d = new DOMParser().parseFromString('<a Foo="1" foo="2"/>', 'application/xml');
var a = d.documentElement;
a.setAttribute('BAR', '3');
console.log(a.getAttribute('Foo'), a.getAttribute('foo'), a.getAttribute('FOO'), a.getAttribute('BAR'), a.getAttribute('bar'), a.hasAttribute('bar'), a.hasAttribute('BAR'), a.attributes.length, a.getAttributeNames().join());
a.removeAttribute('FOO'); a.toggleAttribute('Foo'); a.toggleAttribute('Zed');
console.log(s.serializeToString(a), d.createAttribute('MiXed').name, a.attributes.getNamedItem('BAR').value, a.attributes.getNamedItem('bar'));
var x = new DOMParser().parseFromString('<p xmlns="http://www.w3.org/1999/xhtml" CLASS="a" class="b" ID="x" id="y"/>', 'application/xhtml+xml');
var p = x.documentElement;
p.setAttribute('TITLE', 't');
console.log(p.className, p.id, JSON.stringify(p.title), p.getAttribute('TITLE'), p.getAttribute('title'), x.getElementById('y') === p, x.getElementById('x'));
console.log(x.querySelector('.b') === p, x.querySelector('#y') === p, x.querySelector('[CLASS]') === p, x.querySelector('[class="b"]') === p, x.querySelector('[Class]'), p.matches('P'), p.matches('p'));
console.log(s.serializeToString(p));
