show('h5', 'font-size margin-top');
show('h6', 'font-size margin-top');
show('p', 'margin-top margin-bottom margin');
show('b', 'font-weight'); show('bb', 'font-weight'); show('i', 'font-style'); show('em', 'font-style'); show('ad', 'font-style');
show('a', 'text-decoration-line cursor'); show('plain', 'color text-decoration-line cursor');
show('sm', 'font-size'); show('sub', 'font-size vertical-align'); show('c', 'font-family'); show('mk', 'background-color color');
show('un', 'text-decoration-line'); show('sk', 'text-decoration-line');
show('ul', 'padding-left list-style-type margin-top margin-bottom'); show('ul2', 'margin-top margin-bottom list-style-type');
show('li', 'list-style-type'); show('li2', 'list-style-type'); show('ol', 'list-style-type padding-left'); show('oli', 'list-style-type');
show('q', 'margin-left margin-right margin-top'); show('th', 'font-weight padding-top padding-left vertical-align');
show('td', 'padding-top font-weight'); show('pre', 'white-space font-family margin-top');
show('hr', 'border-top-style border-top-width margin-top overflow-x'); show('fs', 'margin-left padding-top padding-left border-top-width border-top-style');
show('lg', 'padding-left'); show('dd', 'margin-left');
