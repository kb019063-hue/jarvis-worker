[5, true, null, undefined, {}, function () {}, Symbol('s'), { length: 2, 0: 'a', 1: 'b' }].forEach(function (v) {
  r.push(t(function () { return [...v]; }) + '/' + t(function () { for (var x of v) {} }) + '/' + t(function () { return new Set(v); }) + '/' + t(function () { var [a] = v; }));
});
console.log(r.join(' '));
