TypeError TypeError TypeError

#name the iterator method must return an object
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [];
[5, 'str', null, undefined].forEach(function (v) {
  var o = {}; o[Symbol.iterator] = function () { return v; };
  r.push(t(function () { return [...o]; }));
});
var o2 = {}; o2[Symbol.iterator] = function () { return {}; };
r.push(t(function () { return [...o2]; }));
var o3 = {}; o3[Symbol.iterator] = function () { return { next: 5 }; };
r.push(t(function () { return [...o3]; }));
console.log(r.join(' | '));
#expect
TypeError | TypeError | TypeError | TypeError | TypeError | TypeError

#name a Symbol.iterator that is null, undefined or not a function
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [];
[null, undefined, 0, '', {}].forEach(function (v) { var o = {}; o[Symbol.iterator] = v; r.push(t(function () { return [...o]; })); });
console.log(r.join(' | '));
#expect
TypeError | TypeError | TypeError | TypeError | TypeError

#name break closes the iterator once, with the iterator as this and no arguments
#code
var log = [];
var it = { i: 0, next: function () { return { value: this.i++, done: false }; }, return: function () { log.push('return ' + (this === it) + ' ' + arguments.length); return {}; } };
var o = {}; o[Symbol.iterator] = function () { return it; };
for (var x of o) { if (x === 2) break; }
console.log(log.join(), it.i);
#expect
return true 0 3

#name an error in the loop body closes the iterator, and is the error that is seen
#code
var log = [];
function make(ret) { var o = {}; o[Symbol.iterator] = function () { return { next: function () { return { value: 1, done: false }; }, return: ret }; }; return o; }
function t(f) { try { f(); return 'no error'; } catch (e) { return e instanceof Error ? e.constructor.name + ':' + e.message : String(e); } }
console.log(t(function () { for (var x of make(function () { log.push('r1'); return {}; })) throw new RangeError('body'); }));
console.log(t(function () { for (var x of make(function () { log.push('r2'); throw new Error('from return'); })) throw new RangeError('body'); }));
console.log(t(function () { for (var x of make(function () { log.push('r3'); return 5; })) throw new RangeError('body'); }));
console.log(t(function () { for (var x of make(7)) throw new RangeError('body'); }));
console.log(log.join());
#expect
RangeError:body
RangeError:body
RangeError:body
RangeError:body
r1,r2,r3

#name break: what return gives back must be an object, and what it throws is thrown
#code
function make(ret) { var o = {}; o[Symbol.iterator] = function () { return { next: function () { return { value: 1, done: false }; }, return: ret }; }; return o; }
function t(f) { try { f(); return 'no error'; } catch (e) { return e instanceof Error ? e.constructor.name : String(e); } }
var r = [];
[function () { return {}; }, function () { return 5; }, function () { return undefined; }, function () { return null; }, function () { return function () {}; }, function () { throw 'thrown'; }, undefined, null, 5, 'str', {}].forEach(function (ret) {
  r.push(t(function () { for (var x of make(ret)) break; }));
});
console.log(r.join(' | '));
#expect
no error | TypeError | TypeError | TypeError | no error | thrown | no error | no error | TypeError | TypeError | TypeError

#name an iterator that fails is not closed
#code
var log = [];
function make(next) { var o = {}; o[Symbol.iterator] = function () { return { next: next, return: function () { log.push('closed'); return {}; } }; }; return o; }
function t(f) { try { f(); return 'no error'; } catch (e) { return e instanceof Error ? e.constructor.name : String(e); } }
var r = [];
r.push(t(function () { for (var x of make(function () { throw 'next threw'; })) {} }));
r.push(t(function () { for (var x of make(function () { return 5; })) {} }));
r.push(t(function () { for (var x of make(function () { return { get done() { throw 'done threw'; } }; })) {} }));
r.push(t(function () { for (var x of make(function () { return { done: false, get value() { throw 'value threw'; } }; })) {} }));
r.push(t(function () { for (var x of make(5)) {} }));
r.push(t(function () { for (var x of make(undefined)) {} }));
console.log(r.join(' | '), log.length);
#expect
next threw | TypeError | done threw | value threw | TypeError | TypeError 0

#name next is read once, and done before value
#code
var log = [];
var iterator = { get next() { log.push('get next'); return function () { log.push('call next'); return { get done() { log.push('get done'); return log.length > 12; }, get value() { log.push('get value'); return 1; } }; }; } };
var o = { get [Symbol.iterator]() { log.push('get iterator'); return function () { log.push('call iterator'); return iterator; }; } };
var n = 0; for (var x of o) n++;
console.log(n, log.join());
#expect
3 get iterator,call iterator,get next,call next,get done,get value,call next,get done,get value,call next,get done,get value,call next,get done

#name spread, Array.from, Set and a call do not close an iterator they finish
#code
var log = [];
function make(n) { var o = {}; o[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < n ? { value: i++, done: false } : { value: undefined, done: true }; }, return: function () { log.push('closed'); return {}; } }; }; return o; }
var a = [...make(3)], b = Array.from(make(2)), c = new Set(make(2)), d = Math.max(...make(4));
console.log(a.join(), b.join(), c.size, d, log.length);
#expect
0,1,2 0,1 2 3 0

#name a bad entry closes the iterator of Map, WeakMap and Object.fromEntries
#code
var log = [];
function make(name) { var o = {}; o[Symbol.iterator] = function () { return { next: function () { return { value: 5, done: false }; }, return: function () { log.push(name + ' closed'); return {}; } }; }; return o; }
function t(f) { try { f(); return 'no error'; } catch (e) { return e.constructor.name; } }
console.log(t(function () { new Map(make('Map')); }), t(function () { new WeakMap(make('WeakMap')); }), t(function () { Object.fromEntries(make('fromEntries')); }), t(function () { new WeakSet(make('WeakSet')); }), log.join());
#expect
TypeError TypeError TypeError TypeError Map closed,WeakMap closed,fromEntries closed,WeakSet closed

#name return closes the iterator, continue does not
#code
var log = [];
function make() { var o = {}; o[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < 3 ? { value: i++, done: false } : { done: true }; }, return: function () { log.push('closed'); return {}; } }; }; return o; }
function f() { for (var x of make()) { if (x === 1) return 'returned ' + x; } }
function g() { var n = 0; for (var x of make()) { if (x === 1) continue; n++; } return n; }
function h() { outer: for (var a of make()) { for (var b of make()) { if (b === 1) continue outer; if (a === 2) break outer; } } return 'done'; }
console.log(f(), log.length, g(), log.length, h(), log.length);
#expect
returned 1 1 2 1 done 5

#name break closes a generator: its finally runs
#code
var log = [];
function* gen() { try { yield 1; yield 2; yield 3; } finally { log.push('finally'); } }
for (var x of gen()) { if (x === 2) break; }
var [first] = gen();
var it = gen(); it.next(); var s = [...it];
console.log(log.join(), first, s.join());
#expect
finally,finally,finally 1 2,3

#name destructuring closes an iterator it does not finish
#code
var log = [];
function make(n) { var o = {}; o[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < n ? { value: i++, done: false } : { value: undefined, done: true }; }, return: function () { log.push('closed'); return {}; } }; }; return o; }
var [a, b] = make(5); var [c, ...d] = make(3); var [e, f, g] = make(2); var [] = make(1);
console.log(a, b, c, d.join(), e, f, g, log.join());
#expect
0 1 0 1,2 0 1 undefined closed,closed

#name Promise.all closes the iterator when resolve throws
