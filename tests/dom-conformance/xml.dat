#name insertAdjacentHTML and outerHTML in an XML document
#code
var s = new XMLSerializer();
var d = new DOMParser().parseFromString('<a><b/></a>', 'application/xml');
var b = d.documentElement.firstChild;
b.insertAdjacentHTML('beforebegin', '<x/>');
b.insertAdjacentHTML('beforeend', '<Y/>t');
b.insertAdjacentHTML('afterend', '<!--z-->');
console.log(s.serializeToString(d));
b.outerHTML = '<z><w/></z>';
console.log(s.serializeToString(d), b.parentNode);
try { d.documentElement.insertAdjacentHTML('afterbegin', '<open>'); } catch (err) { console.log(err.name); }
try { d.documentElement.outerHTML = '<q/>'; } catch (err) { console.log(err.name); }
