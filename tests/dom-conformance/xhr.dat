#fixture
<html><head><title>XMLHttpRequest</title></head><body><div id="host"></div></body></html>

#name a request for a data: URL is answered
#code
var x = new XMLHttpRequest(), seen = [];
['readystatechange', 'loadstart', 'progress', 'load', 'error', 'abort', 'timeout', 'loadend'].forEach(function (type) {
    x.addEventListener(type, function (e) {
        seen.push(type === 'readystatechange' ? 'state ' + x.readyState : type + ' ' + e.loaded + ' ' + e.total + ' ' + e.lengthComputable);
    });
});
x.addEventListener('loadend', function () {
    console.log(seen.join(', '));
    console.log(x.readyState, x.status, x.statusText, x.responseText, x.getResponseHeader('Content-Type'), x.getResponseHeader('content-length'));
});
console.log(x.readyState, x.status, JSON.stringify(x.statusText), JSON.stringify(x.responseText), x.responseXML, x.getResponseHeader('content-type'));
x.open('GET', 'data:text/plain,hello');
console.log(x.readyState, x.status, JSON.stringify(x.responseText), x.responseXML);
x.send();
console.log(x.readyState, x.status, JSON.stringify(x.responseText), seen.join(', '));
#expect
0 0 "" "" null null
1 0 "" null
1 0 "" state 1, loadstart 0 0 false
state 1, loadstart 0 0 false, state 2, state 3, progress 5 0 false, state 4, load 5 0 false, loadend 5 0 false
4 200 OK hello text/plain null

#name the response comes after the script that asked for it
#code
var x = new XMLHttpRequest(), order = [];
x.onload = function () { order.push('load'); };
x.onloadend = function () { order.push('loadend'); console.log(order.join(' ')); };
x.open('GET', 'data:text/plain,z');
x.send();
order.push('sent');
Promise.resolve().then(function () { order.push('microtask'); });
#expect
sent microtask load loadend

#name what a listener sees in each state
#code
var x = new XMLHttpRequest();
x.onreadystatechange = function () {
    var xml;
    try { xml = x.responseXML ? x.responseXML.documentElement.nodeName : String(x.responseXML); } catch (e) { xml = e.name; }
    console.log(x.readyState, x.status, x.responseText.length, xml, x.getResponseHeader('content-type'));
};
x.open('GET', 'data:text/xml,<a><b/></a>');
x.send();
#expect
1 0 0 null null
2 200 0 null text/xml
3 200 11 null text/xml
4 200 11 a text/xml

#name responseXML is an XML document
#code
var x = new XMLHttpRequest();
x.onload = function () {
    var d = x.responseXML, root = d.documentElement;
    console.log(d.nodeType, d.nodeName, root.nodeName, root.namespaceURI, root.firstChild.nodeName, root.firstChild.namespaceURI, root.lastChild.nodeValue);
    console.log(d instanceof Document, d === x.responseXML, root.ownerDocument === d, d !== document, d.defaultView, d.readyState);
    console.log(d.querySelector('b').getAttribute('id'), d.getElementById('k') === root.firstChild, d.getElementsByTagNameNS('urn:x', 'b').length, d.createElement('P').nodeName);
    console.log(new XMLSerializer().serializeToString(d));
    console.log(x.responseText, typeof x.response, x.response === x.responseText);
};
x.open('GET', 'data:application/xml,<a xmlns="urn:x"><b id="k">t</b><![CDATA[c]]></a>');
x.send();
