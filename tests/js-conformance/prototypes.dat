#name the prototype of a derived class is its parent
#code
class Base {}
class Derived extends Base {}
console.log(Object.getPrototypeOf(Derived) === Base, typeof Object.getPrototypeOf(Derived), Derived.__proto__ === Base, Reflect.getPrototypeOf(Derived) === Base, Object.getPrototypeOf(Base) === Function.prototype);
#expect
true function true true true

#name what getPrototypeOf gives for a class can be called with new
#code
class Base { constructor(x) { this.x = x; } static make(x) { return new this(x); } }
class Derived extends Base {}
var Parent = Object.getPrototypeOf(Derived);
var p = new Parent(3);
console.log(p.x, p instanceof Base, p instanceof Derived, Parent.make(4).x, Parent.name, Parent.length);
#expect
3 true false 4 Base 1

#name three levels: the walk up from a class ends at Function.prototype
#code
class A {} class B extends A {} class C extends B {}
var names = [], o = C;
while (o !== Function.prototype) { names.push(o.name); o = Object.getPrototypeOf(o); }
console.log(names.join(' > '), Object.getPrototypeOf(o) === Object.prototype, Object.getPrototypeOf(Object.prototype) === null);
#expect
C > B > A true true

#name static members are inherited, not copied
#code
class Base { static s() { return 'static of Base'; } static f = 7; }
class Derived extends Base {}
console.log(Derived.s(), Derived.f, Derived.hasOwnProperty('s'), Derived.hasOwnProperty('f'), 's' in Derived, Derived.s === Base.s);
Base.later = 'added later';
console.log(Derived.later);
Base.s = function () { return 'replaced'; };
console.log(Derived.s());
Derived.s = function () { return 'own'; };
console.log(Derived.s(), Base.s());
#expect
static of Base 7 false false true true
added later
replaced
own replaced

#name a static getter and setter run with the subclass as this
#code
class A { static get who() { return this.name; } static set v(x) { this._v = x * 2; } static count() { this.n = (this.n || 0) + 1; return this.n; } }
class B extends A {}
B.v = 4;
console.log(B.who, A.who, B._v, A._v, B.count(), B.count(), A.n, B.hasOwnProperty('n'));
#expect
B A 8 undefined 1 2 undefined true

#name super in static methods over three levels
#code
class A { static a() { return 'a'; } static who() { return 'A:' + this.name; } }
class B extends A { static b() { return 'b' + super.a(); } static who() { return 'B>' + super.who(); } }
class C extends B { static c() { return 'c' + super.b(); } static who() { return 'C>' + super.who(); } }
console.log(C.c(), C.a(), C.who(), B.who());
#expect
cba a C>B>A:C B>A:B

#name super.x in a static method reads a field and a getter of the parent
#code
class A { static f = 1; static get g() { return 'g of ' + this.name; } }
class B extends A { static read() { return [super.f, super.g, typeof super.nope].join(); } }
console.log(B.read());
#expect
1,g of B,undefined

#name Object.setPrototypeOf on a class changes what super() calls
#code
class A { constructor() { this.from = 'A'; } static s() { return 'sA'; } }
class O { constructor() { this.from = 'O'; } static s() { return 'sO'; } }
class B extends A { constructor() { super(); } }
var first = new B();
Object.setPrototypeOf(B, O);
var second = new B();
console.log(first.from, second.from, second instanceof A, second instanceof O, Object.getPrototypeOf(B) === O, B.s());
#expect
A O true false true sO

#name super() when the parent has been taken away or is not a constructor
#code
class A {}
class B extends A { constructor() { super(); } }
var r = [];
Object.setPrototypeOf(B, null);
try { new B(); r.push('constructed'); } catch (e) { r.push(e.name); }
r.push(typeof B.call, Object.getPrototypeOf(B) === null);
Object.setPrototypeOf(B, () => 1);
try { new B(); r.push('constructed'); } catch (e) { r.push(e.name); }
Object.setPrototypeOf(B, {});
try { new B(); r.push('constructed'); } catch (e) { r.push(e.name); }
Object.setPrototypeOf(B, A);
r.push(new B() instanceof A);
console.log(r.join(' '));
#expect
TypeError undefined true TypeError TypeError true

#name extends null
#code
class N extends null { static s() { return 1; } }
var r = [Object.getPrototypeOf(N) === Function.prototype, Object.getPrototypeOf(N.prototype) === null, N.s()];
try { new N(); r.push('constructed'); } catch (e) { r.push(e.name); }
console.log(r.join(' '));
#expect
true true 1 TypeError

#name what cannot be extended
#code
var r = [];
try { class Y extends (() => 1) {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class Z extends 5 {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class W extends ({}) {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class V extends (async function () {}) {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class U extends (function* () {}) {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class T extends ({ m() {} }).m {} r.push('ok'); } catch (e) { r.push(e.name); }
try { class S extends undefined {} r.push('ok'); } catch (e) { r.push(e.name); }
console.log(r.join(' '));
#expect
TypeError TypeError TypeError TypeError TypeError TypeError TypeError

#name extends an ES5 constructor function
#code
function Old(x) { this.x = x; }
Old.make = function () { return new this(9); };
Old.prototype.get = function () { return this.x; };
class New extends Old { get() { return 'new ' + super.get(); } }
console.log(New.make().get(), Object.getPrototypeOf(New) === Old, New.make() instanceof Old, New.hasOwnProperty('make'));
#expect
new 9 true true false

#name a class made by a mixin function
#code
class Base { static kind() { return 'base'; } hello() { return 'hello'; } }
var Serializable = function (B) { return class extends B { static kind() { return 'serializable ' + super.kind(); } save() { return 'saved ' + this.hello(); } }; };
var Loud = function (B) { return class extends B { hello() { return super.hello().toUpperCase(); } }; };
class Thing extends Loud(Serializable(Base)) {}
var chain = [], o = Thing;
while (o !== Function.prototype) { chain.push(o.name || '(anonymous)'); o = Object.getPrototypeOf(o); }
console.log(Thing.kind(), new Thing().save(), chain.length, chain[0], chain[chain.length - 1], Base.isPrototypeOf(Thing));
#expect
serializable base saved HELLO 4 Thing Base true

#name extends Error and TypeError
#code
class E extends Error { constructor(m) { super(m); this.name = 'E'; } }
class T extends TypeError {}
var e = new E('boom'), t = new T('x');
console.log(e instanceof E, e instanceof Error, e.message, String(e), Object.getPrototypeOf(E) === Error);
console.log(Object.getPrototypeOf(T) === TypeError, Object.getPrototypeOf(Object.getPrototypeOf(T)) === Error, t instanceof T, t instanceof TypeError, t instanceof Error, t.name, t.message);
#expect
true true boom E: boom true
true true true true true TypeError x

#name extends Array, Map and Promise: the parent's static methods are found
#code
class A extends Array { static make() { return new this(); } }
class M extends Map { static make() { return new this([[1, 2]]); } }
class P extends Promise {}
console.log(Object.getPrototypeOf(A) === Array, typeof A.from, typeof A.of, A.isArray(A.make()), A.make() instanceof A, A.hasOwnProperty('isArray'));
console.log(Object.getPrototypeOf(M) === Map, M.make().get(1), M.make() instanceof M, M.make() instanceof Map);
console.log(Object.getPrototypeOf(P) === Promise, typeof P.resolve, typeof P.all, typeof P.reject, P.hasOwnProperty('resolve'));
#expect
true function function true true false
true 2 true true
true function function function false

#name extends Object, Function, Date, RegExp, String, Number
#code
class O extends Object {} class D extends Date {} class R extends RegExp {} class S extends String {} class N extends Number {}
console.log(Object.getPrototypeOf(O) === Object, O.keys({ a: 1 }).join(), typeof D.now, typeof D.UTC, S.fromCharCode(65), N.isInteger(3), N.MAX_SAFE_INTEGER === Number.MAX_SAFE_INTEGER, N.parseFloat('1.5'));
console.log(Object.getPrototypeOf(D) === Date, Object.getPrototypeOf(R) === RegExp, Object.getPrototypeOf(S) === String, Object.getPrototypeOf(N) === Number, new S('ab').length, new N(5) + 1, new R('a+').test('caat'));
#expect
true a function function A true true 1.5
true true true true 2 6 true

#name the six error constructors have Error as their prototype
#code
var names = ['TypeError', 'RangeError', 'SyntaxError', 'ReferenceError', 'EvalError', 'URIError'];
console.log(names.map(function (n) {
  var C = globalThis[n];
  return [Object.getPrototypeOf(C) === Error, Error.isPrototypeOf(C), C.name === n, C.length, C.prototype.constructor === C, Object.getPrototypeOf(C.prototype) === Error.prototype, new C('m') instanceof Error, new C('m') instanceof C, new C('m').message].join(' ');
}).join('\n'));
console.log(Object.getPrototypeOf(Error) === Function.prototype, Error.name, Error.length, typeof Object.getPrototypeOf(TypeError), Object.getPrototypeOf(TypeError).name);
#expect
true true true 1 true true true true m
true true true 1 true true true true m
true true true 1 true true true true m
true true true 1 true true true true m
true true true 1 true true true true m
true true true 1 true true true true m
true Error 1 function Error

#name the text of an error constructor, and calling one found by getPrototypeOf
#code
console.log(String(TypeError), String(Error));
var Parent = Object.getPrototypeOf(RangeError);
var made = new Parent('m'), called = Parent('n');
console.log(made instanceof Error, made instanceof RangeError, made.message, called instanceof Error, called.message, Parent === Error);
#expect
function TypeError() { [native code] } function Error() { [native code] }
true false m true n true

#name how testharness.js checks that a constructor is an error type
#code
function is_error_type(constructor) {
  if (typeof constructor !== 'function') return false;
  var obj = constructor, steps = 0;
  while (obj) {
    if (typeof obj === 'function' && obj.name === 'Error') break;
    obj = Object.getPrototypeOf(obj);
    steps++;
  }
  return obj != null ? 'yes after ' + steps : 'no after ' + steps;
}
class Mine extends TypeError {}
class Unrelated {}
console.log([TypeError, RangeError, SyntaxError, ReferenceError, EvalError, URIError, Error, Mine, Unrelated, function () {}, Object, Array].map(is_error_type).join(' | '));
#expect
yes after 1 | yes after 1 | yes after 1 | yes after 1 | yes after 1 | yes after 1 | yes after 0 | yes after 2 | no after 3 | no after 3 | no after 3 | no after 3

