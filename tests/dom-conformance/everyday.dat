#name elements/scroll_top: read
#code
function scrollTop(el, value) {
  var win;
  if (el.window === el) {
    win = el;
  } else if (el.nodeType === 9) {
    win = el.defaultView;
  }
  if (value === undefined) {
    return win ? win.pageYOffset : el.scrollTop;
  }
}
console.log(scrollTop(window), scrollTop(document), scrollTop(document.body));
#expect
0 0 0

