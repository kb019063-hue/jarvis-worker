#name elements/next
#code
function next(el, selector) {
  const nextEl = el.nextElementSibling;
  if (!selector || (nextEl && nextEl.matches(selector))) {
    return nextEl;
  }
  return null;
}
var el = document.querySelector('.first');
console.log(next(el).textContent, next(el, '.last'), next(el, '.item').textContent, next(document.querySelector('.last')));
#expect
Two null Two null

