z,2 z,1 z,3 z,3 z 2 a,b

#name an iterator deleted from String.prototype: a string is not iterable
#code
var original = String.prototype[Symbol.iterator];
delete String.prototype[Symbol.iterator];
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [];
r.push(t(function () { return [...'ab']; }));
r.push(t(function () { var o = []; for (var x of 'ab') o.push(x); return o; }));
r.push(t(function () { return new Set('ab').size; }));
r.push(t(function () { var [a] = 'ab'; return a; }));
String.prototype[Symbol.iterator] = original;
console.log(r.join(' | '), [...'ab'].join());
