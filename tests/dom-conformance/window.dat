https://example.test/app/page.html?tab=2#top https: example.test example.test "" /app/page.html ?tab=2 #top https://example.test https://example.test/app/page.html?tab=2#top true true function function function

#name setting location.hash changes the URL and fires hashchange later
#code
var out = [];
window.addEventListener('hashchange', function (e) { out.push('event ' + e.oldURL.split('#')[1] + '>' + e.newURL.split('#')[1] + ' ' + e.bubbles + ' ' + e.cancelable + ' ' + (e.target === window)); console.log(out.join(', ')); });
location.hash = 'second';
out.push('after set ' + location.hash + ' ' + location.href.split('#')[1] + ' ' + document.URL.split('#')[1]);
#expect
after set #second second second, event top>second false false true

#name onhashchange and several hash changes
#code
var n = 0;
window.onhashchange = function (e) { n++; if (n === 2) console.log(n, location.hash, e.newURL.split('#')[1]); };
location.hash = '#a';
location.hash = 'b';
location.hash = 'b';
#expect
2 #b b

#name setting href to the same page with another hash is a hash change
#code
window.addEventListener('hashchange', function () { console.log('hashchange', location.hash, history.length); });
var before = history.length;
location.href = location.href.split('#')[0] + '#viahref';
console.log(location.hash, history.length - before);
#expect
#viahref 1
hashchange #viahref 2

#name history.pushState and replaceState change the URL without events
#code
var events = 0;
window.addEventListener('popstate', function () { events++; });
window.addEventListener('hashchange', function () { events++; });
var before = history.length;
history.pushState({page: 1}, '', '/app/other?x=1');
console.log(location.pathname, location.search, location.href, history.length - before, history.state.page, document.URL === location.href);
history.replaceState({page: 2}, '', 'relative.html#h');
console.log(location.href, history.length - before, history.state.page);
history.pushState(null, '');
console.log(location.href, history.state, history.length - before);
setTimeout(function () { console.log(events); }, 10);
#expect
/app/other ?x=1 https://example.test/app/other?x=1 1 1 true
https://example.test/app/relative.html#h 1 2
https://example.test/app/relative.html#h null 2
0

#name pushState to another origin throws SecurityError
#code
try { history.pushState(null, '', 'https://other.test/'); console.log('no error'); } catch (e) { console.log(e.name, e.code, location.host); }
try { history.pushState(); console.log('no error'); } catch (e) { console.log(e.name); }
#expect
SecurityError 18 example.test
TypeError

#name back, forward and go fire popstate later, with the state
#code
var out = [];
window.addEventListener('popstate', function (e) {
  out.push(location.pathname + ':' + JSON.stringify(e.state) + ':' + (e.state === history.state) + ':' + (e instanceof PopStateEvent));
  if (out.length === 1) history.forward();
  else if (out.length === 2) { history.go(-2); }
  else console.log(out.join(' '));
});
history.pushState({n: 1}, '', '/one');
history.pushState({n: 2}, '', '/two');
history.back();
out.length || console.log('nothing yet', location.pathname);
#expect
nothing yet /two
/one:{"n":1}:true:true /two:{"n":2}:true:true /app/page.html:null:true:true

#name history.length and going nowhere
#code
console.log(typeof history.length, history.length >= 1, history.state, history instanceof History);
history.go(50); history.back();
setTimeout(function () { console.log(location.href); }, 10);
#expect
number true null true
https://example.test/app/page.html?tab=2#top

