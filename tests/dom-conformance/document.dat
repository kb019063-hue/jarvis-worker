<head><script>window.first = document.currentScript !== null && document.currentScript.tagName; window.countAtFirst = document.scripts.length;</script></head><body><script id="second">window.second = document.currentScript.id;</script></body>
#code
console.log(window.first, window.second, window.countAtFirst, document.scripts.length, document.currentScript);
