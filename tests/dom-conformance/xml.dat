#name a doctype a script made is the document's doctype, and keeps its place
#code
var impl = document.implementation;
var type = impl.createDocumentType('root', 'pub', 'sys');
var d = impl.createDocument('urn:x', 'root', type);
console.log(d.doctype === type, type.parentNode === d, type.ownerDocument === d, d.firstChild === type, d.childNodes.length, type.nextSibling === d.documentElement, d.documentElement.previousSibling === type);
var before = d.insertBefore(d.createComment('before'), type);
var between = d.insertBefore(d.createComment('between'), d.documentElement);
d.appendChild(d.createComment('after'));
function names(doc) { return Array.prototype.map.call(doc.childNodes, function (n) { return n.nodeName + (n.nodeType === 8 ? ':' + n.data : ''); }).join(' '); }
console.log(names(d), new XMLSerializer().serializeToString(d));
d.removeChild(before);
console.log(names(d), d.firstChild === type);
type.remove();
console.log(names(d), d.doctype, type.parentNode, type.ownerDocument === d);
d.insertBefore(type, between);
console.log(names(d), d.doctype === type);
var other = impl.createDocumentType('other', '', '');
d.replaceChild(other, type);
console.log(names(d), d.doctype === other, type.parentNode);
d.replaceChild(d.createComment('was doctype'), other);
console.log(names(d), d.doctype);
[
    function () { d.appendChild(type); },
    function () { d.insertBefore(type, d.documentElement.nextSibling); },
    function () { d.insertBefore(d.createElement('second'), d.firstChild); },
    function () { d.documentElement.appendChild(type); },
    function () { d.insertBefore(type, d.firstChild); d.insertBefore(other, d.firstChild); },
    function () { var e = d.documentElement; d.removeChild(e); d.insertBefore(e, type); },
    function () { d.insertBefore(d.documentElement, d.firstChild); },
].forEach(function (f, i) { try { f(); console.log(i, 'done', names(d)); } catch (err) { console.log(i, err.name, names(d)); } });
var h = impl.createHTMLDocument('t');
console.log(h.doctype.name, h.firstChild === h.doctype, h.childNodes.length);
h.insertBefore(h.createComment('c'), h.doctype);
console.log(names(h), h.doctype.previousSibling.data);
#expect
true true true true 2 true true
