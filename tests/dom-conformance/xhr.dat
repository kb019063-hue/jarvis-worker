#name open() checks the method and the address
#code
function attempt(method, url) {
    var x = new XMLHttpRequest();
    try { x.open(method, url); return 'opened ' + x.readyState; } catch (e) { return e.name + ' ' + (e instanceof DOMException) + ' ' + x.readyState; }
}
