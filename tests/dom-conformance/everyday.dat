#name elements/val: single and multiple select
#code
function val(el) {
  if (el.options && el.multiple) {
    return [...el.options]
      .filter((option) => option.selected)
      .map((option) => option.value);
  } else {
    return el.value;
  }
}
var form = document.getElementById('form');
console.log(val(form.elements.user), val(form.elements.pick), val(form.elements.many).join('+'));
#expect
ann b x+z

#name elements/wrap
