Number.prototype[Symbol.iterator] = function* () { for (var i = 0; i < this; i++) yield i; };
var out = []; for (var x of 3) out.push(x);
function count() { return arguments.length; }
console.log([...3].join(), out.join(), new Set(4).size, count(...5));
#expect
0,1,2 0,1,2 4 5

#name a boolean is iterable when Boolean.prototype has an iterator
