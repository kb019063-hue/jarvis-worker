#name the arguments object is iterable, and can be given an iterator
#code
function f() { var out = []; for (var x of arguments) out.push(x); return out.join() + '|' + [...arguments].join() + '|' + Array.from(arguments).join() + '|' + new Set(arguments).size; }
function g() { arguments[Symbol.iterator] = function* () { yield 'mine'; }; return [...arguments].join(); }
function h() { return typeof arguments[Symbol.iterator] + ' ' + (arguments[Symbol.iterator] === Array.prototype[Symbol.iterator]); }
console.log(f(1, 2, 2), g(1, 2), h());
#expect
1,2,2|1,2,2|1,2,2|2 mine function true

#name a Map and a Set with an iterator of their own
#code
var m = new Map([[1, 'a']]); m[Symbol.iterator] = function* () { yield ['x', 'y']; };
var s = new Set([1]); s[Symbol.iterator] = function* () { yield 'z'; };
var out = []; for (var e of m) out.push(e.join('=')); for (var v of s) out.push(v);
console.log(out.join(), [...new Map(m)].join(), [...new Set(s)].join(), Array.from(m).join(), [...m.keys()].join());
#expect
x=y,z x,y z x,y 1

#name an iterator replaced on Map.prototype and Set.prototype
#code
var om = Map.prototype[Symbol.iterator], os = Set.prototype[Symbol.iterator];
Map.prototype[Symbol.iterator] = function* () { yield ['pm', 1]; }; Set.prototype[Symbol.iterator] = function* () { yield 'ps'; };
var r = [[...new Map([[1, 2]])].join(), [...new Set([1])].join(), new Map(new Map([[1, 2]])).has('pm'), new Set(new Set([5])).has('ps')];
Map.prototype[Symbol.iterator] = om; Set.prototype[Symbol.iterator] = os;
console.log(r.join(), [...new Map([[1, 2]])].join(), [...new Set([5])].join());
#expect
pm,1,ps,true,true 1,2 5

#name generators and array iterators are iterable, once
#code
function* g() { yield 1; yield 2; }
var it = g(); var a = [...it], b = [...it];
var ai = [1, 2, 3][Symbol.iterator](); ai.next(); var c = [...ai];
console.log(a.join(), b.length, c.join(), it[Symbol.iterator]() === it, ai[Symbol.iterator]() === ai);
#expect
1,2 0 2,3 true true

#name the array iterator borrowed by an array-like and by a String object
#code
var like = { length: 2, 0: 'a', 1: 'b' }; like[Symbol.iterator] = Array.prototype[Symbol.iterator];
var str = new String('xy'); str[Symbol.iterator] = Array.prototype[Symbol.iterator];
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
console.log(t(function () { return [...like].join(); }), t(function () { return [...str].join(); }), t(function () { return Array.prototype[Symbol.iterator].call('pq').next().value; }));
#expect
a,b x,y p

#name yield* over an array with an iterator of its own, a string and a plain array
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 'A'; };
var os = String.prototype[Symbol.iterator];
function* g() { yield* a; yield* 'xy'; yield* [3, 4]; }
var first = [...g()].join();
String.prototype[Symbol.iterator] = function* () { yield 'S'; };
var second = [...g()].join();
String.prototype[Symbol.iterator] = os;
console.log(first, second);
#expect
A,x,y,3,4 A,S,3,4

#name iteration after a collection ran in the middle of it
#code
var a = [1, 2, 3]; a[Symbol.iterator] = function* () { for (var i = this.length - 1; i >= 0; i--) { if (typeof gc === 'function') gc(); yield this[i]; } };
var out = []; for (var x of a) { if (typeof gc === 'function') gc(); out.push(x); }
if (typeof gc === 'function') gc();
var plain = []; for (var y of [4, 5, 6]) { if (typeof gc === 'function') gc(); plain.push(y); }
console.log(out.join(), plain.join(), [...a].join(), [...'ab'].join(), [...[7, 8]].join());
#expect
3,2,1 4,5,6 3,2,1 a,b 7,8

#name an async generator is not iterable by the sync protocol
#code
async function* g() { yield 1; }
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
console.log(t(function () { return [...g()].length; }), t(function () { for (var x of g()) return typeof x; }), t(function () { return new Set(g()).size; }), typeof g()[Symbol.iterator], typeof g()[Symbol.asyncIterator]);
#expect
TypeError TypeError TypeError undefined function

#name an object with next and no Symbol.iterator, in yield* and in for await
#code
var bare = { i: 0, next: function () { return this.i < 2 ? { value: this.i++, done: false } : { done: true }; } };
function* g() { yield* bare; }
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
console.log(t(function () { return [...g()].join(); }));
(async function () { try { for await (var x of bare) {} console.log('no error'); } catch (e) { console.log(e.constructor.name); } })();
#expect
TypeError
TypeError

#name yield* over sync iterables in an async generator
#code
async function* outer() { yield* [1, 2]; yield* 'ab'; yield* new Set([7]); }
(async function () { var out = []; for await (var x of outer()) out.push(x); console.log(out.join()); })().catch(function (e) { console.log('rejected: ' + e); });
#expect
1,2,a,b,7

#name for await over an array of promises and values
#code
(async function () { var out = []; for await (var x of [Promise.resolve(1), 2, Promise.resolve(3)]) out.push(x); console.log(out.join()); })();
#expect
1,2,3

#name apply, Reflect.apply, Reflect.construct, bind and the array methods do not ask for an iterator
#code
var original = Array.prototype[Symbol.iterator]; var calls = 0;
Array.prototype[Symbol.iterator] = function () { calls++; return original.call(this); };
function f() { return arguments.length; }
function C() { this.n = arguments.length; }
var r = [f.apply(null, [1, 2]), Reflect.apply(f, null, [1, 2, 3]), Reflect.construct(C, [1]).n, Math.max.apply(null, [3, 9, 4]), String.fromCharCode.apply(null, [104, 105]), f.call.apply(f, [null, 1, 2])];
var bound = f.bind(null, 1, 2); r.push(bound(3));
r.push([1, 2].concat([3]).length, [3, 1, 2].sort().join(''), [1, [2, [3]]].flat(2).length, JSON.stringify([1, 2]), [1, 2].map(function (x) { return x; }).length, new Array(1, 2).length, Array.of(1, 2).length, Object.entries({ a: 1 }).length);
Array.prototype[Symbol.iterator] = original;
console.log(r.join(), calls);
#expect
2,3,1,9,hi,2,3,3,123,3,[1,2],2,2,2,1 0

#name template literals, tagged templates, rest parameters and join do not ask for an iterator
#code
var original = Array.prototype[Symbol.iterator]; var calls = 0;
Array.prototype[Symbol.iterator] = function () { calls++; return original.call(this); };
function tag(strings) { return strings.length + ':' + (arguments.length - 1); }
function rest(a, ...more) { return more.length; }
var r = [`a${1}b${2}`, tag`x${1}y${2}z`, rest(1, 2, 3), (function () { return arguments.length; })(1, 2), [1, 2, 3].join('-'), String([1, 2]), [1, 2] + '', Object.keys([1, 2]).length];
Array.prototype[Symbol.iterator] = original;
console.log(r.join(), calls);
#expect
a1b2,3:2,2,2,1-2-3,1,2,1,2,2 0

#name array destructuring asks the array for its iterator
#code
var a = [1, 2]; a[Symbol.iterator] = function* () { yield 9; yield 8; };
var [x, y] = a; var [h, ...rest] = a;
function f([p, q]) { return p + ':' + q; }
console.log(x, y, h, rest.join(), f(a));
#expect
9 8 9 8 9:8

#name array destructuring: no iterator on Array.prototype, or an object that only has next
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var bare = { i: 0, next: function () { return this.i < 2 ? { value: this.i++, done: false } : { done: true }; } };
var r = [t(function () { var [a] = bare; return a; })];
var original = Array.prototype[Symbol.iterator];
delete Array.prototype[Symbol.iterator];
r.push(t(function () { var [a] = [1]; return a; }));
Array.prototype[Symbol.iterator] = original;
console.log(r.join(' | '));
#expect
TypeError | TypeError

#name Array.from reads what has no iterator as array-like
#code
var oa = Array.prototype[Symbol.iterator], os = String.prototype[Symbol.iterator];
delete Array.prototype[Symbol.iterator]; delete String.prototype[Symbol.iterator];
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var r = [t(function () { return Array.from([1, 2]); }), t(function () { return Array.from('ab'); }), t(function () { return Array.from('a\u{1F600}').length; })];
Array.prototype[Symbol.iterator] = oa; String.prototype[Symbol.iterator] = os;
console.log(r.join(' | '));
#expect
1,2 | a,b | 3

#name Array.from asks a number that was made iterable
#code
Number.prototype[Symbol.iterator] = function* () { for (var i = 0; i < this; i++) yield i; };
console.log(Array.from(3).join(), Array.from(2, function (v) { return v + 10; }).join());
#expect
0,1,2 10,11

#name Array.from maps each value as it arrives, and closes the iterator when the mapper throws
#code
var log = [];
var o = {}; o[Symbol.iterator] = function () { var i = 0; return { next: function () { log.push('next'); return i < 5 ? { value: i++, done: false } : { value: undefined, done: true }; }, return: function () { log.push('closed'); return {}; } }; };
try { Array.from(o, function (v) { log.push('map ' + v); if (v === 1) throw new Error('mapper'); return v; }); } catch (e) { log.push(e.message); }
console.log(log.join());
#expect
next,map 0,next,map 1,closed,mapper

#name the Set and Map constructors call add and set, and close the iterator when those throw
#code
var log = [];
function make(name) { var o = {}; o[Symbol.iterator] = function () { var i = 0; return { next: function () { return i < 3 ? { value: [i, i++], done: false } : { value: undefined, done: true }; }, return: function () { log.push(name + ' closed'); return {}; } }; }; return o; }
var add = Set.prototype.add, set = Map.prototype.set, calls = 0;
Set.prototype.add = function (v) { calls++; return add.call(this, v); };
Map.prototype.set = function (k, v) { calls++; return set.call(this, k, v); };
var s = new Set(make('Set')), m = new Map(make('Map'));
Set.prototype.add = function () { throw new Error('add threw'); }; Map.prototype.set = function () { throw new Error('set threw'); };
function t(f) { try { f(); return 'no error'; } catch (e) { return e.message; } }
var r = [t(function () { new Set(make('Set')); }), t(function () { new Map(make('Map')); })];
Set.prototype.add = add; Map.prototype.set = set;
console.log(s.size, m.size, calls, r.join(), log.join());
#expect
3 3 6 add threw,set threw Set closed,Map closed

#name Array.prototype[Symbol.iterator] is Array.prototype.values, and the others likewise
#code
console.log(Array.prototype[Symbol.iterator] === Array.prototype.values, Array.prototype[Symbol.iterator].name,
  Map.prototype[Symbol.iterator] === Map.prototype.entries, Set.prototype[Symbol.iterator] === Set.prototype.values, Set.prototype.keys === Set.prototype.values,
  String.prototype[Symbol.iterator].name);
#expect
true values true true true [Symbol.iterator]

#name array iterators take next from one prototype
#code
var it = [][Symbol.iterator](); var proto = Object.getPrototypeOf(it);
var shape = [Object.prototype.hasOwnProperty.call(it, 'next'), typeof proto.next, proto === Object.getPrototypeOf([].keys()), proto === Object.getPrototypeOf(new Map().keys()), Object.prototype.toString.call(it)];
var original = proto.next, calls = 0;
proto.next = function () { calls++; return original.call(this); };
var s = [...[1, 2, 3]]; for (var x of [1]) {}
proto.next = original;
console.log(shape.join(), s.join(), calls);
#expect
false,function,true,false,[object Array Iterator] 1,2,3 6

#name no property is named 'Symbol.iterator' or '@@iterator'
#code
function t(f) { try { return String(f()); } catch (e) { return e.constructor.name; } }
var o = { '@@iterator': function* () { yield 2; } };
console.log('Symbol.iterator' in [], typeof []['Symbol.iterator'], typeof ''['Symbol.iterator'], typeof new Map()['Symbol.iterator'],
  Object.getOwnPropertyNames(Array.prototype).indexOf('Symbol.iterator'), '@@iterator' in [], typeof []['@@iterator'], t(function () { return [...o]; }));
