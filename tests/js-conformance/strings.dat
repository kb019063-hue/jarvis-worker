#name length and index
#code
var s = "hello"; console.log(s.length, s[0], s[s.length - 1], s[9])
#expect
5 h o undefined

#name charAt out of range
#code
console.log("abc".charAt(1), "abc".charAt(9) === "", "abc".charCodeAt(9))
#expect
b true NaN

#name fromCharCode and codePointAt
#code
console.log(String.fromCharCode(72, 105), "A".codePointAt(0), String.fromCodePoint(9731).length)
#expect
Hi 65 1

#name indexOf with position and lastIndexOf
#code
console.log("banana".indexOf("a", 2), "banana".lastIndexOf("a"), "banana".indexOf("x"))
#expect
3 5 -1

#name includes startsWith endsWith
#code
var s = "hello world"; console.log(s.includes("lo w"), s.startsWith("world", 6), s.endsWith("hello", 5), s.includes(""))
#expect
true true true true

#name slice with negatives
#code
console.log("abcdef".slice(-3), "abcdef".slice(1, -1), "abcdef".slice(4, 2) === "")
#expect
def bcde true

#name substring swaps and clamps
#code
console.log("abcdef".substring(4, 1), "abcdef".substring(-2, 2), "abcdef".substring(3))
#expect
bcd ab def

#name substr
#code
console.log("abcdef".substr(1, 3), "abcdef".substr(-2))
#expect
bcd ef

#name case conversion
#code
console.log("MiXed".toLowerCase(), "MiXed".toUpperCase())
#expect
mixed MIXED

#name trim variants
#code
var s = "\t x y \n"; console.log("[" + s.trim() + "]", s.trimStart().length, s.trimEnd().length)
#expect
[x y] 5 5

#name padStart and padEnd
#code
console.log("5".padStart(3, "0"), "ab".padEnd(5, "xy") + "|", "abc".padStart(2))
#expect
005 abxyx| abc

#name repeat
#code
console.log("ab".repeat(3), "x".repeat(0) === "")
#expect
ababab true

#name split with separator and limit
#code
console.log("a,b,,c".split(",").length, "a b c".split(" ", 2).join("|"), "abc".split("").join("-"), "abc".split().length)
#expect
4 a|b a-b-c 1

#name split then join
#code
console.log("the quick brown".split(" ").map(function(w){ return w[0].toUpperCase() + w.slice(1); }).join(" "))
#expect
The Quick Brown

#name replace first occurrence only
#code
console.log("a-b-c".replace("-", "+"))
#expect
a+b-c

#name replaceAll
#code
console.log("a-b-c".replaceAll("-", "+"))
#expect
a+b+c

#name replace with function
#code
console.log("a1b22".replace(/\d+/g, function(m){ return "<" + m.length + ">"; }))
#expect
a<1>b<2>

#name replace with capture groups
#code
console.log("John Smith".replace(/(\w+)\s(\w+)/, "$2, $1"))
#expect
Smith, John

#name match with global flag
#code
console.log("a1b22c333".match(/\d+/g).join())
#expect
1,22,333

#name match without global returns groups
#code
var m = "x=12".match(/(\w)=(\d+)/); console.log(m[0], m[1], m[2], m.index)
#expect
x=12 x 12 0

#name search
#code
console.log("hello".search(/l+/), "hello".search(/z/))
#expect
2 -1

#name concat and plus
#code
console.log("a".concat("b", 1, null), "a" + "b" + 1)
#expect
ab1null ab1

#name string comparison and localeCompare
#code
console.log("apple" < "banana", "a".localeCompare("b") < 0, "b".localeCompare("a") > 0, "a".localeCompare("a"))
#expect
true true true 0

#name strings are immutable
#code
var s = "abc"; s[0] = "z"; s.length = 1; console.log(s, s.length)
#expect
abc 3

#name template literal expressions
#code
var n = 3, o = {k: "v"}; console.log(`n=${n} sum=${n + 1} k=${o.k} ${n > 2 ? "big" : "small"}`)
#expect
n=3 sum=4 k=v big

#name template literal with function call
#code
function up(s){ return s.toUpperCase(); } console.log(`${up("a")}${[1,2].map(function(x){ return x * 2; }).join("")}`)
#expect
A24

#name number to string conversions
#code
console.log(String(1.50), (0.1).toFixed(2), (1234.5678).toFixed(1), (255).toString(2), (10).toString())
#expect
1.5 0.10 1234.6 11111111 10

#name string to number conversions
#code
console.log(Number("42"), Number(""), Number(" 12 "), Number("12px"), Number("0x1f"), Number("1e3"), +"3.5")
#expect
42 0 12 NaN 31 1000 3.5

#name parseInt variants
#code
console.log(parseInt("42"), parseInt("  7.9"), parseInt("0x1f"), parseInt("101", 2), parseInt("z", 36), parseInt("abc"), parseInt(""))
#expect
42 7 31 5 35 NaN NaN

#name parseFloat variants
#code
console.log(parseFloat("3.14abc"), parseFloat(".5"), parseFloat("-1e2x"), parseFloat("x"))
#expect
3.14 0.5 -100 NaN

#name String conversions of values
#code
console.log(String(null), String(undefined), String(true), String([1,2]), String({}), String(12.0))
#expect
null undefined true 1,2 [object Object] 12

#name unicode length in UTF-16 units
#code
console.log("café".length, "日本".length, "😀".length)
#expect
4 2 2

#name unicode iteration by code point
#code
console.log([..."a😀b"].length, Array.from("日本").join("|"))
#expect
3 日|本

#name unicode case and index
#code
console.log("é".toUpperCase(), "straße".length, "日本語".charAt(1), "日本語".indexOf("語"))
#expect
É 6 本 2

#name at with negative index
#code
console.log("abc".at(-1), "abc".at(0), "abc".at(9))
#expect
c a undefined

#name escape sequences round trip
#code
var s = "a\"b\\c"; console.log(s.length, JSON.stringify(s))
#expect
5 "a\"b\\c"

#name multiline split
#code
console.log("a\nb\r\nc".split(/\r?\n/).length)
#expect
3

#name trim and split words
#code
console.log("  one   two  three ".trim().split(/\s+/).length)
#expect
3

#name reverse a string
#code
console.log("hello".split("").reverse().join(""))
#expect
olleh

#name count occurrences
#code
console.log("banana".split("a").length - 1, ("banana".match(/an/g) || []).length)
#expect
3 2

#name capitalize
#code
var s = "word"; console.log(s.charAt(0).toUpperCase() + s.slice(1))
#expect
Word

#name string includes is case sensitive
#code
console.log("Hello".includes("hello"), "Hello".toLowerCase().includes("hello"))
#expect
false true

#name typeof string and String object
#code
console.log(typeof "a", typeof String("a"), typeof new String("a"), "a" === String("a"))
#expect
string string object true

#name string methods on literals and numbers
#code
console.log("abc".length, (12).toString().length, 12..toString().length)
#expect
3 2 2

#name String.raw
#code
console.log(String.raw`a\nb${1}`.length)
#expect
5

#name tagged template
#code
function tag(s, a, b){ return s.raw.length + ":" + s[1] + a + b; } console.log(tag`x${1}y${2}z`)
#expect
3:y12

#name localeCompare sort
#code
console.log(["b","a","c"].sort(function(x, y){ return x.localeCompare(y); }).join(""))
#expect
abc

#name codePoint handling of surrogate pair
#code
var s = "😀"; console.log(s.codePointAt(0), s.charCodeAt(0), s.charCodeAt(1))
#expect
128512 55357 56832

#name lastIndexOf and slice path helpers
#code
var p = "/a/b/file.txt"; console.log(p.slice(p.lastIndexOf("/") + 1), p.slice(p.lastIndexOf(".") + 1))
#expect
file.txt txt

#name number formatting helpers
#code
console.log((5).toString().padStart(2, "0") + ":" + String(7).padStart(2, "0"), (1234567.891).toFixed(2))
#expect
05:07 1234567.89

#name encodeURIComponent and decodeURIComponent
#code
console.log(encodeURIComponent("a b&c/d?e=é"), decodeURIComponent("%E2%9C%93%20ok"))
#expect
a%20b%26c%2Fd%3Fe%3D%C3%A9 ✓ ok

#name encodeURI keeps reserved characters
#code
console.log(encodeURI("http://x.y/a b?q=1&r=é#h"))
#expect
http://x.y/a%20b?q=1&r=%C3%A9#h

#name string comparison is by code unit
#code
console.log("a" > "B", "Z" < "a", "abc" < "abd", "" < "a")
#expect
true true true true

#name isWellFormed-free normalization check
#code
console.log("abc".normalize() === "abc")
#expect
true

#name split with regex capture
#code
console.log("1a2b3".split(/[ab]/).join(), "1a2".split(/(a)/).length)
#expect
1,2,3 3

#name escape and unescape
#code
console.log(escape('a b+c/@*_-.'), escape('\u00e4\u20ac\ud83d\ude00'), escape(''), unescape('%u20AC%E4%20%zz%u12') === '\u20ac\u00e4 %zz%u12', unescape(escape('\u00fc \u00df \u6f22\u5b57')) === '\u00fc \u00df \u6f22\u5b57', escape(1.5), unescape('%41%u0042c'))
#expect
a%20b+c/@*_-. %E4%u20AC%uD83D%uDE00  true true 1.5 ABc

#name String object exposes characters as properties
#code
var s = new String('abc'); console.log(s[1], s.length, Object.keys(s).join(), '1' in s, s.hasOwnProperty(2), s.hasOwnProperty(3), Object.getOwnPropertyNames(s).join(), s[5], typeof s)
#expect
b 3 0,1,2 true true false 0,1,2,length undefined object

#name String object in for-in, entries and spread
#code
var s = new String('hi'), keys = []; for (var k in s) keys.push(k); s.extra = 1; console.log(keys.join(), JSON.stringify(Object.entries(new String('ab'))), JSON.stringify(Object.assign({}, new String('xy'))), JSON.stringify({ ...'ab' }), Object.keys(s).join(), Array.prototype.map.call(s, function (c) { return c.toUpperCase(); }).join(''))
#expect
0,1 [["0","a"],["1","b"]] {"0":"x","1":"y"} {"0":"a","1":"b"} 0,1,extra HI

#name String object characters are read only
#code
var s = new String('abc'); s[0] = 'z'; s[7] = 'q'; s.length = 1; console.log(s[0], s[7], s.length, String(s), Object.keys(s).join(), delete s[0], s[0])
#expect
a q 3 abc 0,1,2,7 false a

#name every way two halves of a pair can meet
#code
var hi = "\uD83D", lo = "\uDE00", face = "\uD83D\uDE00", out = [];
function chk(label, got, want) { var ok = got === want && [...got].length === [...want].length && got.length === want.length; var o = {}; o[got] = 1; ok = ok && o[want] === 1 && new Set([got, want]).size === 1 && got.codePointAt(got.indexOf(hi) < 0 ? 0 : got.indexOf(hi)) === want.codePointAt(want.indexOf(hi) < 0 ? 0 : want.indexOf(hi)); out.push(label + ":" + ok); }
chk("repeat", (lo + hi).repeat(3), lo + face + face + hi);
chk("repeat1", (lo + "x" + hi).repeat(2), lo + "x" + face + "x" + hi);
chk("replace-remove", (hi + "-" + lo).replace("-", ""), face);
chk("replace-regex", (hi + "--" + lo).replace(/-+/, ""), face);
chk("replaceAll", ("a" + hi + "-" + lo + "-b").replaceAll("-", ""), "a" + face + "b");
chk("replace-fn", "a-b".replace("-", function () { return hi; }) .replace("b", lo), "a" + face);
chk("replace-with-half", "xy".replace("x", hi).replace("y", lo), face);
chk("replace-$", (hi + "-").replace("-", "$`").length === 2 ? "ok" : "bad", "ok");
chk("replace-insert-after", hi.replace(/$/, lo), face);
chk("replace-insert-before", lo.replace(/^/, hi), face);
chk("replace-$&", (hi + "x").replace("x", lo + "$&"), face + "x");
chk("replace-groups", ("<" + lo + hi + ">").replace(/<(.)(.)>/, "$2$1"), face);
chk("split-join", (hi + "," + lo).split(",").join(""), face);
chk("join-sep", ["a" + hi, "b"].join(lo), "a" + face + "b");
chk("join-many", [hi, lo, hi, lo].join(""), face + face);
chk("reverse-join", [lo, hi].reverse().join(""), face);
chk("array-tostring", String([hi]).concat(lo), face);
chk("json-escape", JSON.parse('"\\ud83d\\ude00"'), face);
chk("json-escape-mixed", JSON.parse('"\\ud83d"') + JSON.parse('"\\ude00"'), face);
chk("json-roundtrip", JSON.parse(JSON.stringify(hi)) + JSON.parse(JSON.stringify(lo)), face);
chk("json-in-array", JSON.parse('["\\ud83d","\\ude00"]').join(""), face);
chk("json-raw-then-escape", JSON.parse('"a\\ud83d' + '\\ude00b"'), "a" + face + "b");
chk("fromCharCode-sep", String.fromCharCode(0xD83D) + String.fromCharCode(0xDE00), face);
chk("fromCharCode-many", String.fromCharCode(0x61, 0xD83D, 0xDE00, 0x62), "a" + face + "b");
chk("fromCodePoint", String.fromCodePoint(0xD83D) + String.fromCodePoint(0xDE00), face);
chk("padStart", lo.padStart(2, hi), face);
chk("padStart-long", lo.padStart(4, "ab" + hi), "ab" + hi + lo);
chk("padEnd-cycle", "".padEnd(4, lo + hi), lo + face + hi);
chk("trim", (" " + hi).trim() + (lo + " ").trim(), face);
chk("concat-method", hi.concat(lo), face);
chk("concat-3", "".concat(hi, lo, hi, lo), face + face);
chk("template", `${hi}${lo}`, face);
chk("template-text", `a${hi}` + `${lo}b`, "a" + face + "b");
chk("raw", String.raw`${hi}${lo}`, face);
chk("slice-concat", face.slice(0, 1) + face.slice(1), face);
chk("substr-concat", face.substr(0, 1) + face.substr(1, 1), face);
chk("charAt-concat", face.charAt(0) + face.charAt(1), face);
chk("index-concat", face[0] + face[1], face);
chk("at-concat", face.at(0) + face.at(-1), face);
chk("split-empty-join", face.split("").join(""), face);
chk("spread-units", Array.prototype.map.call(face, function (c) { return c; }).join(""), face);
chk("plus-eq", (function () { var s = "a"; s += hi; s += lo; s += "b"; return s; })(), "a" + face + "b");
chk("plus-eq-prop", (function () { var o = { s: hi }; o.s += lo; return o.s; })(), face);
chk("upper", (hi + "a").toUpperCase().slice(0, 1) + lo.toLowerCase(), face);
chk("normalize", hi.normalize() + lo.normalize(), face);
chk("number-concat", hi + lo + 1, face + "1");
chk("key-concat", Object.keys((function () { var o = {}; o[hi + lo] = 1; return o; })())[0], face);
chk("key-computed", Object.keys({ [hi + lo]: 1 })[0], face);
chk("map-key", (function () { var m = new Map(); m.set(hi + lo, 7); return m.get(face) === 7 ? face : ""; })(), face);
chk("regex-capture-concat", /(.)(.)/.exec(face)[1] + /(.)(.)/.exec(face)[2], face);
chk("match-join", face.match(/[\s\S]/g).join(""), face);
chk("decodeURI", decodeURIComponent("%F0%9F%98%80"), face);
chk("escape-seq", "\u{1F600}", face);
chk("substring-wide", ("xx" + hi).substring(2) + (lo + "yy").substring(0, 1), face);
chk("sort-join", [lo, hi].sort().join(""), face);
chk("toString", new String(hi) + new String(lo), face);
chk("localeUpper", hi.toLocaleUpperCase() + lo.toLocaleLowerCase(), face);
chk("Array.from", Array.from(face.split("")).join(""), face);
chk("reduce", [hi, lo].reduce(function (a, b) { return a + b; }, ""), face);
chk("label-symbol", Symbol(hi + lo).description, face);
chk("fn-name", ({ [hi + lo]: function () {} })[face].name, face);
chk("error-msg", new Error(hi + lo).message, face);
chk("date-nope", "x", "x");
console.log(out.filter(function (l) { return !/:true$/.test(l); }).join(" ") || "all " + out.length + " ok");
#expect
all 63 ok

#name isWellFormed and toWellFormed
#code
var hi = "\uD83D", lo = "\uDE00", f = hi + lo, out = [];
var list = ["", "abc", f, hi, lo, lo + hi, hi + hi + lo, f + lo, "a" + hi + "b" + lo + "c", "\uD7FF\uE000\uFFFD", "\u00ed\u00a0", "x".repeat(1000) + hi, (lo + f).repeat(3), "\uDBFF\uDFFF", "\uDBFF", "\uDC00\uDBFF\uDC00"];
list.forEach(function (s) { var w = s.toWellFormed(); out.push(s.isWellFormed() + ":" + w.isWellFormed() + ":" + (w === s) + ":" + w.length + ":" + Array.prototype.map.call(w.slice(-6), function (c) { return c.charCodeAt(0).toString(16); }).join(".")); });
out.push(String.prototype.isWellFormed.length, String.prototype.toWellFormed.name, String.prototype.isWellFormed.call(123), String.prototype.toWellFormed.call(true));
try { String.prototype.isWellFormed.call(null); } catch (e) { out.push(e.name); }
console.log(out.join(" "));
#expect
true:true:true:0: true:true:true:3:61.62.63 true:true:true:2:d83d.de00 false:true:false:1:fffd false:true:false:1:fffd false:true:false:2:fffd.fffd false:true:false:3:fffd.d83d.de00 false:true:false:3:d83d.de00.fffd false:true:false:5:61.fffd.62.fffd.63 true:true:true:3:d7ff.e000.fffd true:true:true:2:ed.a0 false:true:false:1001:78.78.78.78.78.fffd false:true:false:9:fffd.d83d.de00.fffd.d83d.de00 true:true:true:2:dbff.dfff false:true:false:1:fffd false:true:false:3:fffd.dbff.dc00 0 toWellFormed true true TypeError

