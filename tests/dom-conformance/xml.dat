#name a mutation observer hears of the data of a processing instruction and of a CDATA section
#code
var d = new DOMParser().parseFromString('<a><?p one?><![CDATA[two]]></a>', 'application/xml');
var a = d.documentElement, log = [];
var observer = new MutationObserver(function (records) {
    records.forEach(function (r) { log.push(r.type + ' ' + r.target.nodeType + ' ' + r.oldValue + ' ' + r.addedNodes.length + ' ' + r.removedNodes.length); });
});
observer.observe(a, {characterData: true, characterDataOldValue: true, childList: true, subtree: true});
a.firstChild.data = 'uno';
a.lastChild.data = 'dos';
a.appendChild(d.createProcessingInstruction('q', 'three'));
a.removeChild(a.firstChild);
a.insertBefore(d.createCDATASection('four'), a.firstChild);
observer.takeRecords().forEach(function (r) { log.push(r.type + ' ' + r.target.nodeType + ' ' + r.oldValue + ' ' + r.addedNodes.length + ' ' + r.removedNodes.length + ' ' + (r.addedNodes[0] ? r.addedNodes[0].nodeType : '-')); });
console.log(log.join('; '));
#expect
characterData 7 one 0 0 -; characterData 4 two 0 0 -; childList 1 null 1 0 7; childList 1 null 0 1 -; childList 1 null 1 0 4

#name a small program: reading a feed
#code
var feed = '<?xml version="1.0" encoding="UTF-8"?>\n<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">\n<channel>\n  <title>News &amp; notes</title>\n  <link>https://example.test/</link>\n  <item>\n    <title>First &lt;post&gt;</title>\n    <dc:creator>Ann</dc:creator>\n    <content:encoded><![CDATA[<p>Hello <b>world</b></p>]]></content:encoded>\n    <guid isPermaLink="false">a-1</guid>\n  </item>\n  <item>\n    <title>Second</title>\n    <dc:creator><![CDATA[Bob & Co]]></dc:creator>\n    <guid>https://example.test/2</guid>\n  </item>\n</channel>\n</rss>';
var doc = new DOMParser().parseFromString(feed, 'text/xml');
if (doc.querySelector('parsererror')) console.log('not a feed');
var DC = 'http://purl.org/dc/elements/1.1/', CONTENT = 'http://purl.org/rss/1.0/modules/content/';
console.log(doc.documentElement.getAttribute('version'), doc.querySelector('channel > title').textContent, doc.getElementsByTagName('item').length);
Array.prototype.forEach.call(doc.querySelectorAll('item'), function (item) {
    var creator = item.getElementsByTagNameNS(DC, 'creator')[0];
    var body = item.getElementsByTagNameNS(CONTENT, 'encoded')[0];
    var guid = item.querySelector('guid');
    console.log([item.querySelector('title').textContent, creator.textContent, creator.prefix, body ? body.textContent : '(none)', guid.textContent, guid.getAttribute('isPermaLink')].join(' | '));
});
var host = document.getElementById('host');
Array.prototype.forEach.call(doc.getElementsByTagName('item'), function (item) {
    var li = document.createElement('li');
    li.textContent = item.getElementsByTagName('title')[0].textContent;
    host.appendChild(li);
});
console.log(host.innerHTML);
#expect
2.0 News & notes 2
First <post> | Ann | dc | <p>Hello <b>world</b></p> | a-1 | false
Second | Bob & Co | dc | (none) | https://example.test/2 | 
<li>First &lt;post&gt;</li><li>Second</li>

#name a small program: a drawing fetched as text and put into the page
#code
var text = '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 24" class="icon"><title>Home</title><defs><path id="shape" d="M3 12l9-9 9 9"/></defs><use xlink:href="#shape" fill="none"/></svg>';
var parsed = new DOMParser().parseFromString(text, 'image/svg+xml');
var root = parsed.documentElement;
if (root.nodeName !== 'svg') console.log('not a drawing');
var host = document.getElementById('host');
var icon = document.importNode(root, true);
icon.removeAttribute('class');
icon.setAttribute('width', '24');
host.appendChild(icon);
var use = icon.querySelector('use');
console.log(icon.namespaceURI, icon.tagName, icon.constructor.name, icon.ownerDocument === document, icon.getAttribute('viewBox'), icon.querySelector('title').textContent);
console.log(use.getAttributeNS('http://www.w3.org/1999/xlink', 'href'), use.getAttribute('xlink:href'), use.attributes[0].namespaceURI, use.attributes[0].localName, use.namespaceURI, host.querySelector('svg use') === use, host.querySelector('path').id);
console.log(host.innerHTML);
console.log(new XMLSerializer().serializeToString(icon));
console.log(root.parentNode === parsed, parsed.querySelector('use') !== use, document.querySelectorAll('svg').length);
#expect
http://www.w3.org/2000/svg svg SVGSVGElement true 0 0 24 24 Home
#shape #shape http://www.w3.org/1999/xlink href http://www.w3.org/2000/svg true shape
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 24" width="24"><title>Home</title><defs><path id="shape" d="M3 12l9-9 9 9"></path></defs><use xlink:href="#shape" fill="none"></use></svg>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 24" width="24"><title>Home</title><defs><path id="shape" d="M3 12l9-9 9 9"/></defs><use xlink:href="#shape" fill="none"/></svg>
true true 1

#name a long document and a deep one
#code
var wide = '<list>';
for (var i = 0; i < 3000; i++) wide += '<item n="' + i + '">v' + i + '</item>';
wide += '</list>';
var d = new DOMParser().parseFromString(wide, 'application/xml');
console.log(d.documentElement.children.length, d.documentElement.lastChild.getAttribute('n'), d.querySelectorAll('item[n$="99"]').length, new XMLSerializer().serializeToString(d).length === wide.length);
var deep = '', depth = 2000;
for (i = 0; i < depth; i++) deep += '<n>';
deep += 'bottom';
for (i = 0; i < depth; i++) deep += '</n>';
d = new DOMParser().parseFromString(deep, 'application/xml');
var at = d.documentElement, count = 1;
while (at.firstChild && at.firstChild.nodeType === 1) { at = at.firstChild; count++; }
console.log(count, at.textContent, d.getElementsByTagName('n').length, new XMLSerializer().serializeToString(d) === deep, d.documentElement.textContent);
d = new DOMParser().parseFromString(deep.slice(0, -4), 'application/xml');
console.log(d.documentElement.nodeName, d.getElementsByTagName('n').length);
#expect
3000 2999 30 true
2000 bottom 2000 true bottom
parsererror 0

#name inline SVG read by the HTML parser: its attributes have their names and namespaces
