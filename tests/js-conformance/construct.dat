#name an abstract class: new.target in the parent is the class new was applied to
#code
class Shape {
  constructor() {
    if (new.target === Shape) throw new TypeError('Shape is abstract');
    this.kind = new.target.name;
  }
}
class Circle extends Shape {}
class Dot extends Circle { constructor() { super(); this.dot = true; } }
var r = [new Circle().kind, new Dot().kind, new Dot().dot];
try { new Shape(); r.push('made a Shape'); } catch (e) { r.push(e.name + ': ' + e.message); }
console.log(r.join(' | '));
#expect
Circle | Dot | true | TypeError: Shape is abstract

#name new.target is the same function at every level of a chain of classes
#code
var seen = [];
class A { constructor() { seen.push('A:' + new.target.name); } }
class B extends A { constructor() { super(); seen.push('B:' + new.target.name); } }
class C extends B {}
class D extends C { constructor() { super(); seen.push('D:' + new.target.name); } }
new D(); new C(); new B(); new A();
console.log(seen.join(' '));
#expect
A:D B:D D:D A:C B:C A:B B:B A:A

#name new.target under a function parent: a class that extends a function
#code
var seen = [];
function Base() { seen.push(new.target === undefined ? 'undefined' : new.target.name); }
class Mid extends Base { constructor() { super(); seen.push(new.target.name); } }
class Leaf extends Mid {}
new Leaf(); new Mid(); new Base(); Base();
console.log(seen.join(' '));
#expect
Leaf Leaf Mid Mid Base undefined

#name Reflect.construct(F, args, G): new.target in F is G and the object has G.prototype
#code
function F(a, b) { this.sum = a + b; this.target = new.target; }
function G() { this.neverRuns = true; }
G.prototype.hello = function () { return 'hello from G'; };
var o = Reflect.construct(F, [2, 3], G);
console.log(o.target === G, o.sum, o instanceof G, o instanceof F, o.hello(), 'neverRuns' in o);
var p = Reflect.construct(F, [1, 1]);
console.log(p.target === F, p instanceof F);
var q = Reflect.construct(F, [1, 1], F);
console.log(q.target === F, q instanceof F);
#expect
true 5 true false hello from G false
true true
true true

#name Reflect.construct(Class, args, Other): through super() too
#code
class A { constructor() { this.a = new.target.name; } }
class B extends A { constructor() { super(); this.b = new.target.name; } }
class Other { who() { return 'other'; } }
var o = Reflect.construct(B, [], Other);
console.log(o.a, o.b, o instanceof Other, o instanceof B, o instanceof A, o.who());
#expect
Other Other true false false other

#name new.target is undefined in a call: plain, call(), apply(), Reflect.apply, a method, a callback
#code
function F() { return new.target === undefined ? 'undefined' : typeof new.target; }
var o = { m: function () { return new.target === undefined; }, n() { return new.target === undefined; } };
var r = [F(), F.call({}), F.apply({}, []), Reflect.apply(F, null, []), new F() instanceof F, o.m(), o.n()];
r.push([1].map(function () { return new.target === undefined; })[0]);
console.log(r.join(' '));
#expect
undefined undefined undefined undefined true true true true

#name a constructor called with call() by another constructor sees no new.target
#code
function Parent() { this.viaNew = new.target !== undefined; }
function Child() { Parent.call(this); this.childNew = new.target === Child; }
Child.prototype = Object.create(Parent.prototype);
var c = new Child();
console.log(c.viaNew, c.childNew, new Parent().viaNew);
#expect
false true true

#name the guard that makes a function work with and without new
#code
function Point(x, y) {
  if (!new.target) return new Point(x, y);
  this.x = x; this.y = y;
}
function Strict() { if (new.target === undefined) throw new TypeError('use new'); }
var a = Point(1, 2), b = new Point(3, 4), r = [a instanceof Point, a.x + a.y, b instanceof Point, b.x + b.y];
try { Strict(); r.push('called'); } catch (e) { r.push(e.message); }
r.push(new Strict() instanceof Strict);
console.log(r.join(' '));
#expect
true 3 true 7 use new true

#name an arrow function has the new.target of the function around it
#code
function F() { this.get = () => new.target; this.nested = () => (() => new.target)(); }
function G() {}
class K { constructor() { this.get = () => new.target; } }
class L extends K {}
var f = new F(), g = Reflect.construct(F, [], G), l = new L();
console.log(f.get() === F, f.nested() === F, g.get() === G, g.nested() === G, l.get() === L, new K().get() === K);
function plain() { return (() => new.target)(); }
console.log(plain() === undefined);
#expect
true true true true true true
true

#name a function inside a constructor has a new.target of its own
#code
function Outer() {
  function inner() { return new.target; }
  this.called = inner() === undefined;
  this.made = new inner() instanceof inner;
  var captured;
  function Probe() { captured = new.target; }
  new Probe();
  this.probe = captured === Probe;
  this.mine = new.target === Outer;
}
var o = new Outer();
console.log(o.called, o.made, o.probe, o.mine);
#expect
true false true true

#name new.target is still the same after the constructor made other objects
#code
var log = [];
class Part { constructor() { log.push('Part:' + new.target.name); } }
class SubPart extends Part {}
class Whole {
  constructor() {
    this.a = new Part(); this.b = new SubPart(); this.c = Reflect.construct(Part, [], SubPart);
    [1, 2].forEach(function () { new Part(); });
    log.push('Whole:' + new.target.name);
  }
}
class Bigger extends Whole { constructor() { super(); log.push('Bigger:' + new.target.name); } }
new Bigger();
console.log(log.join(' '));
#expect
Part:Part Part:SubPart Part:SubPart Part:Part Part:Part Whole:Bigger Bigger:Bigger

#name a constructor that makes more of itself: each call has its own new.target
#code
var seen = [];
class Node_ {
  constructor(depth) {
    seen.push(depth + ':' + new.target.name);
    if (depth < 3) this.child = depth % 2 ? new Node_(depth + 1) : new Leaf_(depth + 1);
    seen.push(depth + ':' + new.target.name);
  }
}
class Leaf_ extends Node_ {}
new Node_(0);
console.log(seen.join(' '));
#expect
0:Node_ 1:Leaf_ 2:Node_ 3:Leaf_ 3:Leaf_ 2:Node_ 1:Leaf_ 0:Node_

#name new.target in a parameter default and in a destructured parameter
#code
function F(a = new.target, {b = new.target} = {}) { this.a = a; this.b = b; }
function G() {}
var f = new F(), g = Reflect.construct(F, [], G);
console.log(f.a === F, f.b === F, g.a === G, g.b === G, (function (a = new.target) { return a; })() === undefined);
class K { constructor(t = new.target.name) { this.t = t; } }
class L extends K {}
console.log(new K().t, new L().t);
#expect
true true true true true
K L

#name new.target in a method, a getter, a setter, a static method, a field: undefined
#code
var r = [];
class K {
  f = new.target;
  g = () => new.target;
  static s = new.target;
  constructor() { this.viaGetter = this.probe; this.viaMethod = this.m(); this.value = 1; }
  get probe() { return new.target === undefined; }
  set value(v) { r.push('setter:' + (new.target === undefined)); }
  m() { return new.target === undefined; }
  static sm() { return new.target === undefined; }
}
var k = new K();
r.push(k.viaGetter, k.viaMethod, K.sm(), k.f === undefined, k.g() === undefined, K.s === undefined);
console.log(r.join(' '));
#expect
setter:true true true true true true true

#name new.target in a generator and in an async function is undefined
#code
function* gen() { yield new.target === undefined; yield (() => new.target)() === undefined; }
async function later() { return new.target === undefined; }
var it = gen(), r = [it.next().value, it.next().value];
later().then(function (v) { r.push(v); console.log(r.join(' ')); });
#expect
true true true

#name new on a bound function: new.target is the target function
#code
function F(a, b) { this.nt = new.target; this.args = a + ',' + b; }
var B = F.bind({ignored: true}, 1), BB = B.bind(null, 2);
var x = new B(9), y = new BB();
console.log(x.nt === F, x.args, x instanceof F, y.nt === F, y.args, y instanceof F, 'ignored' in x);
class K { constructor() { this.nt = new.target; } }
var BK = K.bind(null), k = new BK();
console.log(k.nt === K, k instanceof K);
#expect
true 1,9 true true 1,2 true false
true true

#name Reflect.construct on a bound function: the named new.target reaches the target
#code
function F(a) { this.nt = new.target; this.a = a; }
function G() {}
G.prototype.tag = 'G';
var B = F.bind(null, 'bound');
var o = Reflect.construct(B, [], G);
console.log(o.nt === G, o.a, o.tag, o instanceof G, o instanceof F);
var p = Reflect.construct(F, ['direct'], B);
console.log(p.nt === F, p instanceof F, p.a);
#expect
true bound G true false
false false direct

#name Reflect.construct on a bound function whose target returns another object: it comes back untouched
#code
var other = {tag: 'other'};
function F() { return other; }
function G() {}
var r = Reflect.construct(F.bind(null), [], G);
console.log(r === other, Object.getPrototypeOf(r) === Object.prototype, r.tag);
var s = Reflect.construct(F, [], G);
console.log(s === other, Object.getPrototypeOf(s) === Object.prototype);
#expect
true true other
true true

#name a class that extends a bound function: the instance is the one the target was given
#code
var seen;
function F(x) { seen = this; this.x = x; this.nt = new.target.name; }
F.prototype.m = function () { return 'm' + this.x; };
var B = F.bind(null, 7);
B.prototype = F.prototype;
class D extends B { constructor() { super(); this.own = 1; } }
var d = new D();
console.log(seen === d, d.x, d.own, d.nt, d instanceof D, d instanceof F, d.m());
#expect
true 7 1 D true true m7

#name Reflect.construct needs constructors: what it refuses
#code
function F() {}
var r = [];
function attempt(label, fn) { try { fn(); r.push(label + ':ok'); } catch (e) { r.push(label + ':' + e.name); } }
attempt('arrow target', function () { Reflect.construct(F, [], () => 1); });
attempt('method target', function () { Reflect.construct(F, [], {m() {}}.m); });
attempt('undefined target', function () { Reflect.construct(F, [], undefined); });
attempt('object target', function () { Reflect.construct(F, [], {}); });
attempt('arrow constructor', function () { Reflect.construct(() => 1, [], F); });
attempt('no arguments list', function () { Reflect.construct(F); });
attempt('class target', function () { Reflect.construct(F, [], class {}); });
attempt('bound target', function () { Reflect.construct(F, [], F.bind(null)); });
attempt('built-in target', function () { Reflect.construct(F, [], Array); });
console.log(r.join(' '));
#expect
arrow target:TypeError method target:TypeError undefined target:TypeError object target:TypeError arrow constructor:TypeError no arguments list:TypeError class target:ok bound target:ok built-in target:ok

#name new.target.prototype makes the object: the factory idiom
#code
function Base() { var self = Object.create(new.target.prototype); self.made = 'by Base'; return self; }
class Derived extends Base { hello() { return 'hello'; } }
class Further extends Derived { constructor() { super(); this.further = true; } }
var d = new Derived(), f = new Further();
console.log(d instanceof Derived, d.made, d.hello(), f instanceof Further, f.further, f.made, Object.getPrototypeOf(f) === Further.prototype);
#expect
true by Base hello true true by Base true

#name an error names itself after new.target
#code
class AppError extends Error {
  constructor(message) { super(message); this.name = new.target.name; }
}
class NotFound extends AppError {}
class Timeout extends AppError { constructor() { super('timed out'); this.retry = true; } }
var a = new NotFound('no such page'), b = new Timeout(), c = new AppError('plain');
console.log(a.name, a.message, a instanceof NotFound, a instanceof Error, String(a));
console.log(b.name, b.message, b.retry, c.name, Object.prototype.toString.call(a));
#expect
NotFound no such page true true NotFound: no such page
Timeout timed out true AppError [object Error]

#name new.target in a class that extends a built-in: Map, Array, Promise, Error
#code
var seen = [];
class M extends Map { constructor(it) { super(it); seen.push(new.target.name); } }
class N extends M {}
class L extends Array { constructor() { super(); seen.push(new.target.name); } }
class LL extends L {}
class E extends Error { constructor(m) { super(m); seen.push(new.target.name); } }
class EE extends E {}
var n = new N([[1, 'one']]), ll = new LL(), ee = new EE('m');
ll.push(4, 5);
console.log(seen.join(' '), n.get(1), n.size, n instanceof N, ll.length, Array.isArray(ll), ll instanceof LL, ee.message, ee instanceof EE);
#expect
N LL EE one 1 true 2 true true m true

#name a mixin: each layer sees the class that was constructed
#code
var Serializable = function (Base) { return class extends Base { constructor(...a) { super(...a); this.layers = (this.layers || []).concat('S:' + new.target.name); } }; };
var Observable = function (Base) { return class extends Base { constructor(...a) { super(...a); this.layers = (this.layers || []).concat('O:' + new.target.name); } }; };
class Model { constructor(id) { this.id = id; this.layers = ['M:' + new.target.name]; } }
class User extends Observable(Serializable(Model)) {}
var u = new User(7);
console.log(u.id, u.layers.join(' '), u instanceof Model, u instanceof User);
#expect
7 M:User S:User O:User true true

#name Reflect.construct of a built-in with a new.target: the object is the built-in's, with the other prototype
#code
function G() {}
function sub(Parent) { function S() {} S.prototype = Object.create(Parent.prototype); return S; }
var A = sub(Array), a = Reflect.construct(Array, [3], A);
var D = sub(Date), d = Reflect.construct(Date, [0], D);
var S = sub(String), s = Reflect.construct(String, ['ab'], S);
var R = sub(RegExp), re = Reflect.construct(RegExp, ['a+', 'g'], R);
var M = sub(Map), m = Reflect.construct(Map, [[[1, 2]]], M);
var E = sub(Error), e = Reflect.construct(Error, ['boom'], E);
var o = Reflect.construct(Object, [], G);
console.log(a instanceof A, Array.isArray(a), a.length, d instanceof D, d.getTime(), s instanceof S, s.length, s + '!');
console.log(re instanceof R, re.test('caat'), re.flags, m instanceof M, m.get(1), e instanceof E, e.message, Object.getPrototypeOf(o) === G.prototype);
#expect
true true 3 true 0 true 2 ab!
true true g true 2 true boom true

#name Reflect.construct(Function, [body], G): a function with G.prototype
