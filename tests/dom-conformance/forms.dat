typed new default
shows
again again

#name FormData collects the successful controls
#code
var fd = new FormData(document.getElementById('f'));
var pairs = [];
fd.forEach(function (v, k) { pairs.push(k + '=' + (typeof v === 'string' ? v.replace(/\n/g, '\\n') : 'file')); });
console.log(pairs.join('&'));
console.log(fd.get('user'), fd.get('nope'), fd.has('terms'), fd.has('off'), fd.getAll('tags').join('+'), fd.get('action'));
#expect
user=ann&pw=&news=yes&size=l&token=t0k&age=30&mail=&color=g&tags=a&tags=c&note=first\nsecond&up=file&far=away
ann null false false a+c null

#name FormData can be built and changed by hand
#code
var fd = new FormData();
fd.append('a', '1'); fd.append('a', '2'); fd.append('b', 3); fd.set('c', 'x');
console.log(fd.get('a'), fd.getAll('a').join(','), typeof fd.get('b'), fd.has('c'));
fd.set('a', 'only'); fd.delete('b');
console.log(Array.from(fd.keys()).join(','), Array.from(fd.values()).join(','), Array.from(fd.entries()).length, [...fd].map(function (e) { return e.join('='); }).join('&'));
console.log(new URLSearchParams(fd).toString());
#expect
1 1,2 string true
a,c only,x 2 a=only&c=x
a=only&c=x

#name FormData with a submitter and with changed state
#code
var f = document.getElementById('f');
document.getElementById('user').value = 'zed';
document.getElementById('terms').checked = true;
document.getElementById('small').checked = true;
document.getElementById('color').value = 'r';
document.getElementById('note').value = 'n';
var fd = new FormData(f, document.getElementById('go'));
console.log(new URLSearchParams(fd).toString());
#expect
user=zed&pw=&news=yes&terms=on&size=s&token=t0k&age=30&mail=&color=r&tags=a&tags=c&note=n&up=%5Bobject+File%5D&action=save&far=away

#name reset() puts every control back to its default
#code
var f = document.getElementById('f');
document.getElementById('user').value = 'zed';
document.getElementById('news').checked = false;
document.getElementById('small').checked = true;
document.getElementById('color').value = 'r';
document.getElementById('tags').options[1].selected = true;
document.getElementById('note').value = 'typed';
var fired = 0;
f.addEventListener('reset', function (e) { fired++; });
f.reset();
console.log(fired, document.getElementById('user').value, document.getElementById('news').checked, document.getElementById('large').checked, document.getElementById('small').checked, document.getElementById('color').value, document.getElementById('tags').selectedOptions.length, JSON.stringify(document.getElementById('note').value));
#expect
1 ann true true false g 2 "first\nsecond"

#name a cancelled reset event keeps the state; a reset button resets
#code
var f = document.getElementById('f');
var u = document.getElementById('user');
u.value = 'zed';
function stop(e) { e.preventDefault(); }
f.addEventListener('reset', stop);
f.reset();
console.log(u.value);
f.removeEventListener('reset', stop);
document.getElementById('reset').click();
console.log(u.value);
#expect
zed
ann

#name submit by button click: validation runs first
#code
var f = document.getElementById('f');
var submits = 0, invalid = [];
f.addEventListener('submit', function (e) { submits++; e.preventDefault(); });
document.getElementById('mail').addEventListener('invalid', function (e) { invalid.push(e.target.id + ':' + e.bubbles + ':' + e.cancelable); });
document.getElementById('go').click();
console.log(submits, invalid.join(','));
document.getElementById('mail').value = 'a@b.test';
document.getElementById('go').click();
console.log(submits, invalid.length);
#expect
0 mail:false:true
1 1

#name submit() skips validation and the submit event; requestSubmit() does both
#code
var f = document.getElementById('f');
var submits = 0;
f.addEventListener('submit', function (e) { submits++; e.preventDefault(); });
f.requestSubmit();
console.log(submits);
document.getElementById('mail').value = 'a@b.test';
f.requestSubmit();
console.log(submits);
f.requestSubmit(document.getElementById('go'));
console.log(submits);
try { f.requestSubmit(document.getElementById('plain')); } catch (e) { console.log(e.name); }
try { f.requestSubmit(document.createElement('button')); } catch (e) { console.log(e.name); }
#expect
0
1
2
TypeError
NotFoundError

#name novalidate
#code
var f = document.getElementById('f');
var submits = 0;
f.addEventListener('submit', function (e) { submits++; e.preventDefault(); });
f.noValidate = true;
document.getElementById('go').click();
console.log(submits, f.hasAttribute('novalidate'));
#expect
1 true

#name a plain button does not submit; a button with no type does
#code
var f = document.getElementById('f');
document.getElementById('mail').value = 'a@b.test';
var submits = 0;
f.addEventListener('submit', function (e) { submits++; e.preventDefault(); });
document.getElementById('plain').click();
console.log(submits);
var b = document.createElement('button');
f.appendChild(b);
b.click();
console.log(submits, b.type);
b.disabled = true; b.click();
console.log(submits);
#expect
0
1 submit
1

#name checkValidity, reportValidity and validity for required
#code
var m = document.getElementById('mail'), f = document.getElementById('f');
console.log(m.willValidate, m.checkValidity(), m.validity.valid, m.validity.valueMissing, f.checkValidity(), m.validity instanceof ValidityState, m.validationMessage.length > 0);
m.value = 'x@y.test';
console.log(m.checkValidity(), m.validity.valid, m.validity.valueMissing, f.checkValidity(), f.reportValidity(), JSON.stringify(m.validationMessage));
#expect
true false false true false true true
true true false true true ""

#name validity: typeMismatch, tooLong, rangeUnderflow, rangeOverflow, stepMismatch, patternMismatch
#code
var m = document.getElementById('mail'), a = document.getElementById('age');
m.value = 'not an email';
console.log(m.validity.typeMismatch, m.validity.valid);
m.value = 'a@b.c'; console.log(m.validity.typeMismatch, m.validity.valid);
a.value = '0'; console.log(a.validity.rangeUnderflow, a.validity.valid);
a.value = '121'; console.log(a.validity.rangeOverflow, a.validity.valid);
a.value = '5.5'; console.log(a.validity.stepMismatch, a.validity.valid);
a.value = '50'; console.log(a.validity.valid);
var p = document.createElement('input'); p.pattern = '[a-z]{3}'; p.value = 'ab1';
console.log(p.validity.patternMismatch, p.checkValidity()); p.value = 'abc'; console.log(p.validity.patternMismatch); p.value = ''; console.log(p.validity.valid);
var u = document.createElement('input'); u.type = 'url'; u.value = 'nope'; console.log(u.validity.typeMismatch); u.value = 'https://a.test/'; console.log(u.validity.typeMismatch);
#expect
true false
false true
true false
true false
true false
true
true false
false
true
true
false

#name setCustomValidity
#code
var u = document.getElementById('user');
u.setCustomValidity('Name taken');
console.log(u.validity.customError, u.validity.valid, u.validationMessage, u.checkValidity(), document.getElementById('f').checkValidity());
u.setCustomValidity('');
console.log(u.validity.customError, u.validity.valid, JSON.stringify(u.validationMessage));
#expect
true false Name taken false false
false true ""

#name :valid and :invalid follow the state
