var o = {}; o[Symbol.iterator] = function () { return { next: function () { return { value: 1, done: false }; }, return: function () { log.push('closed'); return {}; } }; };
function C(executor) { return new Promise(executor); }
C.resolve = function () { throw new Error('resolve threw'); };
Promise.all.call(C, o).then(null, function (e) { console.log(e.message, log.join()); });
#expect
resolve threw closed

