#name namespaces looked up where there is no element, and selectors with a namespace bar
#code
var frag = document.createDocumentFragment();
var type = document.implementation.createDocumentType('a', '', '');
var empty = document.implementation.createDocument(null, null, null);
var loose = document.createTextNode('t');
console.log(frag.lookupNamespaceURI('xml'), type.lookupNamespaceURI('xmlns'), empty.lookupNamespaceURI('xml'), loose.lookupNamespaceURI('xml'), document.lookupNamespaceURI('xml'), document.body.lookupNamespaceURI('xmlns'), document.createElementNS('urn:x', 'p:e').lookupNamespaceURI('p'));
console.log(frag.isDefaultNamespace(null), type.isDefaultNamespace(''), frag.lookupPrefix('http://www.w3.org/XML/1998/namespace'), document.body.isDefaultNamespace('http://www.w3.org/1999/xhtml'));
var named = document.implementation.createDocument(null, undefined, null);
console.log(named.documentElement.nodeName, document.implementation.createDocument(null, null, null).documentElement, document.implementation.createDocument(null, '', null).documentElement);
var x = new DOMParser().parseFromString('<r xmlns:s="urn:s"><a/><s:a/><b xmlns="urn:b"><a/></b></r>', 'application/xml');
function count(sel) { try { return x.querySelectorAll(sel).length; } catch (err) { return err.name; } }
console.log(count('a'), count('*|a'), count('|a'), count('*|*'), count('|*'), count('s|a'), count('*|'), count('|'), count('r > |a'), count('*|b |a'), count('[*|x]'));
var e = x.createElementNS('urn:s', 'h');
console.log(e.matches('h'), e.matches('*|h'), e.matches('|h'), x.createElementNS('', 'h').matches('|h'), x.documentElement.matches('|r'), document.body.matches('*|body'), document.body.matches('|body'));
var div = document.createElement('div');
div.textContent = undefined;
var kept = document.createTextNode('t');
kept.nodeValue = undefined;
var data = document.createTextNode('t');
data.data = undefined;
console.log(JSON.stringify([div.textContent, div.childNodes.length, kept.data, data.data]));
var one = x.createElementNS('urn:s', 'e'), two = x.createElementNS('urn:s', 'e');
one.setAttributeNS('urn:n', 'p:at', 'v'); two.setAttributeNS('urn:n', 'q:at', 'v');
var three = x.createElementNS('urn:s', 'e'); three.setAttributeNS('urn:other', 'p:at', 'v');
var four = x.createElementNS('urn:s', 'e'); four.setAttribute('p:at', 'v');
console.log(one.isEqualNode(two), one.isEqualNode(three), one.isEqualNode(four), four.isEqualNode(four.cloneNode()));
